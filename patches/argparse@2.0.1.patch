     }
 
     _split_lines(text, width) {
-        text = text.replace(this._whitespace_matcher, ' ').trim()
-        // The textwrap module is used only for formatting help.
-        // Delay its import for speeding up the common usage of argparse.
-        let textwrap = require('./lib/textwrap')
-        return textwrap.wrap(text, { width })
+        if (!this._legacy_output) {
+            text = text.replace(this._whitespace_matcher, ' ').trim()
+            let textwrap = require('./lib/textwrap')
+            return textwrap.wrap(text, { width })
+        }
+
+        let lines = []
+        let delimiter_pattern = /[ .,!?][^ .,!?]*$/
+
+        text = text.replace(/[\n|\t]/g, ' ')
+        text = text.trim().replace(this._whitespace_matcher, ' ')
+
+        for (let line of text.split('\n')) {
+            if (width >= line.length) {
+                lines.push(line)
+                continue
+            }
+
+            let wrap_start = 0
+            let wrap_end = width
+            while (wrap_end <= line.length) {
+                let end = wrap_end
+                if (wrap_end !== line.length) {
+                    let match = delimiter_pattern.exec(line.substring(wrap_start, wrap_end))
+                    if (match) end = wrap_start + match.index + 1
+                }
+                if (end <= wrap_start) end = wrap_end
+                lines.push(line.substring(wrap_start, end))
+                wrap_start = end
+                wrap_end = end + width
+            }
+            if (wrap_start < line.length) {
+                lines.push(line.substring(wrap_start))
+            }
+        }
+
+        return lines
     }
 
