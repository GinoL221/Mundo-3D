<form id="login-form" class="ui-form" method="post" novalidate>
  <div id="login-error" class="ui-callout ui-callout--danger" role="alert" tabindex="-1" hidden>
    <svg class="ui-callout__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="8" x2="12" y2="12" />
      <line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    <div class="ui-callout__content">
      <p id="login-error-text" class="ui-callout__text"></p>
    </div>
  </div>

  <div class="ui-field">
    <label class="ui-label" for="email">Correo electrónico</label>
    <input
      type="email"
      id="email"
      name="email"
      class="ui-input"
      autocomplete="email"
      required
    />
    <p id="email-error" class="ui-error" hidden></p>
  </div>

  <div class="ui-field">
    <label class="ui-label" for="password">Contraseña</label>
    <div class="ui-input-group ui-input-group--field">
      <input
        type="password"
        id="password"
        name="password"
        class="ui-input"
        autocomplete="current-password"
        required
      />
      <button
        type="button"
        class="ui-btn ui-btn--ghost ui-btn--icon"
        data-password-toggle
        aria-pressed="false"
        aria-controls="password"
        aria-label="Mostrar contraseña"
      >
        <svg data-icon="show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        <svg data-icon="hide" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-6.5 0-10-8-10-8a18.45 18.45 0 0 1 5.06-5.94" />
          <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-2.16 3.19" />
          <line x1="2" y1="2" x2="22" y2="22" />
        </svg>
      </button>
    </div>
    <p id="password-error" class="ui-error" hidden></p>
  </div>

  <label for="remember" class="ui-check">
    <input type="checkbox" id="remember" name="remember" class="ui-check__input" />
    <span>Recordarme en este dispositivo</span>
  </label>

  <div class="auth-page__actions">
    <button type="submit" id="login-btn" class="ui-btn ui-btn--primary auth-page__submit" aria-busy="false" disabled>
      Iniciar sesión
    </button>
    <button type="button" class="ui-btn ui-btn--secondary" data-demo-entry hidden>
      Entrar sin cuenta (modo demo)
    </button>
  </div>

  <p class="auth-page__footer">
    ¿No tenés cuenta? <a class="auth-page__link" href="/register">Registrate</a>
  </p>
</form>

<script>
  import { endDemoSession, isDemoSessionActive } from '../../../config';
  import { AuthService } from '../services/auth.service';
  import { broadcastSessionChanged } from '../services/session.service';
  import { CartService } from '../../cart/services/CartService';
  import { bindPasswordToggles } from '../utils/passwordToggle';
  import {
    extractApiFieldErrors,
    summarizeFieldErrors,
    validateLoginInput,
    type LoginFieldName,
  } from '../validation/authValidation';

  // Bounded race, not fire-and-forget (design.md "Resolved: the
  // redirect-vs-GET race"): the redirect must never be delayed beyond this
  // cap, but a true fire-and-forget would let the document unload before the
  // GET resolves, silently dropping the merge. Whichever settles first wins;
  // hydration errors or a timeout must never fail or skip the redirect.
  const HYDRATION_REDIRECT_TIMEOUT_MS = 1500;

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('login-error') as HTMLElement | null;
  const errorText = document.getElementById('login-error-text') as HTMLElement | null;
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement | null;
  const emailEl = document.getElementById('email') as HTMLInputElement | null;
  const passwordEl = document.getElementById('password') as HTMLInputElement | null;
  const rememberEl = document.getElementById('remember') as HTMLInputElement | null;

  const fieldElements: Record<LoginFieldName, { input: HTMLInputElement | null; error: HTMLElement | null }> = {
    email: { input: emailEl, error: document.getElementById('email-error') },
    password: { input: passwordEl, error: document.getElementById('password-error') },
  };

  if (form) {
    bindPasswordToggles(form);
  }

  // One-time cleanup of stale localStorage session keys left over from
  // before the cookie-based auth migration (design.md "Migration/Rollout").
  // Nothing writes/reads them anymore, so leaving them would let a dead
  // "logged in" navbar render forever in already-visited browsers.
  localStorage.removeItem('token');
  localStorage.removeItem('user');

  function setFieldError(field: LoginFieldName, message: string | null): void {
    const entry = fieldElements[field];
    if (!entry) return;
    if (message) {
      entry.input?.setAttribute('aria-invalid', 'true');
      entry.input?.setAttribute('aria-describedby', `${field}-error`);
      if (entry.error) {
        entry.error.textContent = message;
        entry.error.hidden = false;
      }
    } else {
      entry.input?.removeAttribute('aria-invalid');
      entry.input?.removeAttribute('aria-describedby');
      if (entry.error) {
        entry.error.textContent = '';
        entry.error.hidden = true;
      }
    }
  }

  function clearAllFieldErrors(): void {
    setFieldError('email', null);
    setFieldError('password', null);
  }

  function showError(msg: string, focusAlert = true): void {
    if (errorBox && errorText) {
      errorText.textContent = msg;
      errorBox.hidden = false;
      if (focusAlert) {
        errorBox.focus();
      }
    }
  }

  function hideError(): void {
    if (errorBox && errorText) {
      errorText.textContent = '';
      errorBox.hidden = true;
    }
  }

  for (const field of ['email', 'password'] as const) {
    fieldElements[field].input?.addEventListener('input', () => {
      if (fieldElements[field].input?.getAttribute('aria-invalid') === 'true') {
        setFieldError(field, null);
      }
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    clearAllFieldErrors();

    const email = emailEl?.value?.trim() || '';
    const password = passwordEl?.value || '';
    const remember = rememberEl?.checked ?? false;

    const validation = validateLoginInput({ email, password });
    if (validation.summary) {
      for (const [field, msg] of Object.entries(validation.fieldErrors)) {
        if (msg) setFieldError(field as LoginFieldName, msg);
      }
      showError(validation.summary);
      return;
    }

    if (loginBtn) {
      loginBtn.disabled = true;
      loginBtn.ariaBusy = 'true';
      loginBtn.textContent = 'Ingresando…';
    }

    try {
      await AuthService.login(email, password, remember);

      if (isDemoSessionActive()) {
        try {
          localStorage.removeItem('m3d_demo_cart');
        } catch {
          // Storage unavailable.
        }
        await endDemoSession().catch(() => undefined);
        CartService.loadCartFromStorage();
      }

      // Server issues the session as httpOnly/CSRF/display cookies — no
      // client-side storage write needed (design.md "No Script-Readable
      // Auth Token Storage").

      // Notify header and other components in this tab, and any other open
      // tab (symmetric with clearSession()'s broadcast on logout).
      window.dispatchEvent(new CustomEvent('session-changed'));
      broadcastSessionChanged('logged-in');

      // Merge the guest cart into the account's server cart before
      // redirecting, bounded so a slow/failed GET never blocks navigation
      // beyond the cap (cart-hydration spec: "Hydration Entry Point and
      // Triggers").
      const redirect = () => {
        window.location.href = '/';
      };
      await Promise.race([
        CartService.hydrateFromServer({ mergeLocal: true }),
        new Promise((resolve) => setTimeout(resolve, HYDRATION_REDIRECT_TIMEOUT_MS)),
      ]).then(redirect, redirect);
    } catch (err) {
      const apiFieldErrors = extractApiFieldErrors(err);
      const mappedErrors: Partial<Record<LoginFieldName, string>> = {};
      for (const field of ['email', 'password'] as const) {
        if (apiFieldErrors[field]) {
          mappedErrors[field] = apiFieldErrors[field];
          setFieldError(field, apiFieldErrors[field]);
        }
      }

      if (Object.keys(mappedErrors).length > 0) {
        showError(
          summarizeFieldErrors(mappedErrors as Record<string, string>, 'Revisá los campos marcados antes de ingresar.')
        );
      } else if (err instanceof Error) {
        showError(err.message);
      } else {
        showError('No se pudo conectar con el servidor. Intentá de nuevo.');
      }
    } finally {
      if (loginBtn) {
        loginBtn.disabled = false;
        loginBtn.ariaBusy = 'false';
        loginBtn.textContent = 'Iniciar sesión';
      }
    }
  });

  if (form && loginBtn) loginBtn.disabled = false;
</script>
