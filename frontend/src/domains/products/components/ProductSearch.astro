---
// Public search/filter/pagination view for the storefront `/products` page
// (product-catalog-search spec). Self-contained per `frontend.domain.locality`:
// imports only from this domain and `../../../config` — see
// product.search.service.ts. State is entirely URL-driven: a native
// `method="get"` form navigates to `/products?...`, and this component reads
// `window.location.search` on load — no `pushState`, since
// `astro.config.mjs` builds fully static and `Astro.url.searchParams` is a
// build-time-only value (design.md decision #5).
import ProductCard from './ProductCard.astro';
---

<div class="product-search">
  <div class="product-search__toolbar">
    <form method="get" action="/products" class="product-search__form" id="product-search-form">
      <label class="sr-only" for="product-search-input">Buscar productos</label>
      <input type="search" name="search" id="product-search-input" placeholder="Buscar productos..." />
      <label class="sr-only" for="product-search-category">Categoría</label>
      <select name="idCategory" id="product-search-category">
        <option value="">Todas las categorías</option>
      </select>
      <label class="sr-only" for="product-search-franchise">Franquicia</label>
      <select name="idFranchise" id="product-search-franchise">
        <option value="">Todas las franquicias</option>
      </select>
      <button type="submit">Buscar</button>
    </form>
  </div>

  <section class="product-search__catalog" aria-labelledby="product-grid-heading">
    <h2 id="product-grid-heading">Piezas disponibles</h2>
    <div class="product-grid" id="product-grid-container" aria-live="polite">
      <div id="loading-msg" class="product-search__loading" role="status" aria-busy="true">
        <span class="sr-only">Cargando piezas del Catálogo…</span>
        <div class="product-search__skeleton-grid" aria-hidden="true">
          <div class="product-card-skeleton">
            <span class="product-card-skeleton__media ui-skeleton"></span>
            <div class="product-card-skeleton__body">
              <span class="ui-skeleton ui-skeleton--medium"></span>
              <span class="ui-skeleton ui-skeleton--short"></span>
            </div>
          </div>
          <div class="product-card-skeleton">
            <span class="product-card-skeleton__media ui-skeleton"></span>
            <div class="product-card-skeleton__body">
              <span class="ui-skeleton ui-skeleton--medium"></span>
              <span class="ui-skeleton ui-skeleton--short"></span>
            </div>
          </div>
          <div class="product-card-skeleton">
            <span class="product-card-skeleton__media ui-skeleton"></span>
            <div class="product-card-skeleton__body">
              <span class="ui-skeleton ui-skeleton--medium"></span>
              <span class="ui-skeleton ui-skeleton--short"></span>
            </div>
          </div>
          <div class="product-card-skeleton">
            <span class="product-card-skeleton__media ui-skeleton"></span>
            <div class="product-card-skeleton__body">
              <span class="ui-skeleton ui-skeleton--medium"></span>
              <span class="ui-skeleton ui-skeleton--short"></span>
            </div>
          </div>
          <div class="product-card-skeleton">
            <span class="product-card-skeleton__media ui-skeleton"></span>
            <div class="product-card-skeleton__body">
              <span class="ui-skeleton ui-skeleton--medium"></span>
              <span class="ui-skeleton ui-skeleton--short"></span>
            </div>
          </div>
          <div class="product-card-skeleton">
            <span class="product-card-skeleton__media ui-skeleton"></span>
            <div class="product-card-skeleton__body">
              <span class="ui-skeleton ui-skeleton--medium"></span>
              <span class="ui-skeleton ui-skeleton--short"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <nav class="product-search__pagination" id="product-search-pagination" aria-label="Paginación del catálogo" hidden>
    <a id="product-search-prev" href="#" hidden>&laquo; Anterior</a>
    <span id="product-search-page-label"></span>
    <a id="product-search-next" href="#" hidden>Siguiente &raquo;</a>
  </nav>
</div>

<ProductCard />

<template id="loading-state-template">
  <div id="loading-msg" class="product-search__loading" role="status" aria-busy="true">
    <span class="sr-only">Cargando piezas del Catálogo…</span>
    <div class="product-search__skeleton-grid" aria-hidden="true">
      <div class="product-card-skeleton">
        <span class="product-card-skeleton__media ui-skeleton"></span>
        <div class="product-card-skeleton__body">
          <span class="ui-skeleton ui-skeleton--medium"></span>
          <span class="ui-skeleton ui-skeleton--short"></span>
        </div>
      </div>
      <div class="product-card-skeleton">
        <span class="product-card-skeleton__media ui-skeleton"></span>
        <div class="product-card-skeleton__body">
          <span class="ui-skeleton ui-skeleton--medium"></span>
          <span class="ui-skeleton ui-skeleton--short"></span>
        </div>
      </div>
      <div class="product-card-skeleton">
        <span class="product-card-skeleton__media ui-skeleton"></span>
        <div class="product-card-skeleton__body">
          <span class="ui-skeleton ui-skeleton--medium"></span>
          <span class="ui-skeleton ui-skeleton--short"></span>
        </div>
      </div>
      <div class="product-card-skeleton">
        <span class="product-card-skeleton__media ui-skeleton"></span>
        <div class="product-card-skeleton__body">
          <span class="ui-skeleton ui-skeleton--medium"></span>
          <span class="ui-skeleton ui-skeleton--short"></span>
        </div>
      </div>
      <div class="product-card-skeleton">
        <span class="product-card-skeleton__media ui-skeleton"></span>
        <div class="product-card-skeleton__body">
          <span class="ui-skeleton ui-skeleton--medium"></span>
          <span class="ui-skeleton ui-skeleton--short"></span>
        </div>
      </div>
      <div class="product-card-skeleton">
        <span class="product-card-skeleton__media ui-skeleton"></span>
        <div class="product-card-skeleton__body">
          <span class="ui-skeleton ui-skeleton--medium"></span>
          <span class="ui-skeleton ui-skeleton--short"></span>
        </div>
      </div>
    </div>
  </div>
</template>

<template id="empty-state-template">
  <div class="ui-state ui-state--empty product-search__state" role="status">
    <svg
      class="ui-state__icon product-search__state-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
      <path d="m3.3 7 8.7 5 8.7-5" />
      <path d="M12 22V12" />
    </svg>
    <h3 class="ui-state__title">Próximamente</h3>
    <p class="ui-state__text">
      Todavía no hay piezas cargadas en el Catálogo. Si buscás algo puntual, podés enviarnos una solicitud de encargo.
    </p>
    <a class="ui-btn ui-btn--secondary" href="/help">Pedir un encargo a medida</a>
  </div>
</template>

<template id="no-results-state-template">
  <div class="ui-state ui-state--empty product-search__state" role="status">
    <svg
      class="ui-state__icon product-search__state-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.3-4.3" />
    </svg>
    <h3 class="ui-state__title">Sin resultados</h3>
    <p class="ui-state__text">
      No encontramos piezas para esa búsqueda. Probá con otro término o quitá los filtros.
    </p>
    <a class="ui-btn ui-btn--secondary" href="/products">Limpiar filtros</a>
  </div>
</template>

<template id="error-state-template">
  <div class="ui-callout ui-callout--danger product-search__state product-search__state--error" role="alert">
    <svg
      class="ui-callout__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="8" x2="12" y2="12" />
      <line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    <div class="ui-callout__content">
      <h3 class="ui-callout__title">No se pudo cargar</h3>
      <p class="ui-callout__text">No pudimos consultar el Catálogo. Verificá tu conexión e intentá de nuevo.</p>
      <div class="ui-callout__actions">
        <button type="button" class="ui-btn ui-btn--secondary" id="product-search-retry">Reintentar</button>
      </div>
    </div>
  </div>
</template>

<script>
  import { getCategoryImg, isPlaceholderImage } from '../adapters/product.adapter';
  import { resolveImageUrl } from '../../../lib/imageUrl';
  import type { APIProduct } from '../adapters/product.adapter';
  import { fetchProductSearch, fetchFilterOptions } from '../services/product.search.service';
  import type { FilterOption, ProductSearchCriteria } from '../services/product.search.service';
  import {
    formatCatalogPrice,
    formatProductCardAriaLabel,
    presentProductSearchPage,
  } from '../services/productSearchPresenter';

  function getCriteria(): ProductSearchCriteria {
    const params = new URLSearchParams(window.location.search);
    const criteria: ProductSearchCriteria = {};

    const search = params.get('search');
    if (search) criteria.search = search;

    const idCategory = params.get('idCategory');
    if (idCategory) criteria.idCategory = Number.parseInt(idCategory, 10);

    const idFranchise = params.get('idFranchise');
    if (idFranchise) criteria.idFranchise = Number.parseInt(idFranchise, 10);

    const rawPage = params.get('page');
    const parsedPage = rawPage ? Number.parseInt(rawPage, 10) : 1;
    criteria.page = Number.isNaN(parsedPage) || parsedPage < 1 ? 1 : parsedPage;

    return criteria;
  }

  function hasActiveFilters(criteria: ProductSearchCriteria): boolean {
    return Boolean(criteria.search || criteria.idCategory !== undefined || criteria.idFranchise !== undefined);
  }

  function populateSelectOptions(
    select: HTMLSelectElement | null,
    options: FilterOption[],
    selectedId?: number,
  ): void {
    if (!select) return;
    while (select.options.length > 1) {
      select.remove(1);
    }
    for (const item of options) {
      const option = document.createElement('option');
      option.value = String(item.id);
      option.textContent = item.name;
      select.appendChild(option);
    }
    if (selectedId !== undefined) select.value = String(selectedId);
  }

  async function rehydrateForm(criteria: ProductSearchCriteria): Promise<void> {
    const searchInput = document.getElementById('product-search-input') as HTMLInputElement | null;
    if (searchInput && criteria.search) searchInput.value = criteria.search;

    const categorySelect = document.getElementById('product-search-category') as HTMLSelectElement | null;
    const franchiseSelect = document.getElementById('product-search-franchise') as HTMLSelectElement | null;
    const { categories, franchises } = await fetchFilterOptions();

    populateSelectOptions(categorySelect, categories, criteria.idCategory);
    populateSelectOptions(franchiseSelect, franchises, criteria.idFranchise);
  }

  function showState(templateId: string, container: HTMLElement): void {
    const template = document.getElementById(templateId) as HTMLTemplateElement | null;
    if (!template) return;
    container.innerHTML = '';
    container.appendChild(template.content.cloneNode(true));
  }

  function renderGrid(products: APIProduct[], container: HTMLElement): void {
    const cardTemplate = document.getElementById('product-card-template') as HTMLTemplateElement | null;
    if (!cardTemplate) return;

    const fragment = document.createDocumentFragment();
    for (const product of products) {
      const clone = cardTemplate.content.cloneNode(true) as DocumentFragment;

      const catImg = getCategoryImg(product.category || 'Otras');
      const article = clone.querySelector('article') as HTMLElement | null;
      if (article) article.dataset.category = catImg;

      const link = clone.querySelector('.product-card-link') as HTMLAnchorElement | null;
      const img = clone.querySelector('.product-card__category-img') as HTMLImageElement | null;
      const name = clone.querySelector('.product-card-name') as HTMLElement | null;
      const category = clone.querySelector('.product-card-category') as HTMLElement | null;
      const price = clone.querySelector('.product-card-price') as HTMLElement | null;

      if (link) {
        link.href = `/product?id=${product.idProduct}`;
        link.setAttribute('aria-label', formatProductCardAriaLabel(product.nameProduct, product.price));
      }
      if (img) {
        const isPlaceholder = isPlaceholderImage(product.image);
        if (isPlaceholder) {
          img.src = `/images/illustrations/${catImg}.svg`;
          img.alt = product.category || 'Otras';
          img.classList.add('product-card__category-img--pixelart');
        } else {
          img.src = resolveImageUrl(product.image, 'products');
          img.alt = product.nameProduct;
          img.classList.remove('product-card__category-img--pixelart');
        }
        img.addEventListener('error', () => {
          img.src = '/images/illustrations/Otras.svg';
          img.classList.add('product-card__category-img--pixelart');
        });
      }
      if (name) name.textContent = product.nameProduct;
      if (category) category.textContent = product.category || 'Otras';
      if (price) price.textContent = formatCatalogPrice(product.price);

      fragment.appendChild(clone);
    }

    container.innerHTML = '';
    container.appendChild(fragment);
  }

  function renderPagination(pageLabel: string, prevHref: string | null, nextHref: string | null): void {
    const paginationNav = document.getElementById('product-search-pagination');
    const pageLabelEl = document.getElementById('product-search-page-label');
    const prevEl = document.getElementById('product-search-prev') as HTMLAnchorElement | null;
    const nextEl = document.getElementById('product-search-next') as HTMLAnchorElement | null;

    if (paginationNav) {
      paginationNav.hidden = !pageLabel && !prevHref && !nextHref;
    }
    if (pageLabelEl) pageLabelEl.textContent = pageLabel;
    if (prevEl) {
      prevEl.hidden = !prevHref;
      if (prevHref) prevEl.href = prevHref;
    }
    if (nextEl) {
      nextEl.hidden = !nextHref;
      if (nextHref) nextEl.href = nextHref;
    }
  }

  function bindRetryButton(container: HTMLElement): void {
    const retryButton = container.querySelector('#product-search-retry') as HTMLButtonElement | null;
    if (!retryButton) return;

    retryButton.addEventListener('click', () => {
      if (retryButton.disabled) return;
      retryButton.disabled = true;
      showState('loading-state-template', container);
      void loadProducts();
    });
  }

  async function loadProducts(): Promise<void> {
    const container = document.getElementById('product-grid-container') as HTMLElement | null;
    if (!container) return;

    const criteria = getCriteria();
    const [, result] = await Promise.all([rehydrateForm(criteria), fetchProductSearch(criteria)]);

    if (!result.ok) {
      showState('error-state-template', container);
      renderPagination('', null, null);
      bindRetryButton(container);
      return;
    }

    const presentation = presentProductSearchPage(result.page, criteria);
    if (presentation.isEmpty) {
      showState(hasActiveFilters(criteria) ? 'no-results-state-template' : 'empty-state-template', container);
      renderPagination('', null, null);
      return;
    }

    renderGrid(result.page.products, container);
    renderPagination(presentation.pageLabel, presentation.prevHref, presentation.nextHref);
  }

  function disableEmptyControlsBeforeSubmit(): void {
    const form = document.getElementById('product-search-form') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', () => {
      const controls = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select');
      controls.forEach((control) => {
        if (!control.value) control.disabled = true;
      });
    });
  }

  disableEmptyControlsBeforeSubmit();
  void loadProducts();
</script>
