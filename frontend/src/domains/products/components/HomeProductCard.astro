<template id="home-product-card-template">
  <article class="home-product-card">
    <a class="home-product-card__link" href="">
      <div class="home-product-card__media">
        <img class="home-product-card__image" alt="" width="328" height="328" loading="lazy" decoding="async" />
      </div>
      <div class="home-product-card__body">
        <h3 class="home-product-card__name"></h3>
        <div class="home-product-card__footer">
          <p class="home-product-card__price"></p>
          <p class="home-product-card__category"></p>
        </div>
      </div>
    </a>
  </article>
</template>
