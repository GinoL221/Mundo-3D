---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ayuda y encargos — Mundo 3D">
  <main class="form-layout">
    <article class="about-content">
      <section>
        <h1>Contanos tu idea</h1>
        <p>Podés dejar una propuesta sin crear una cuenta. Es una función de demostración local: guardamos la solicitud para revisión; no genera un presupuesto, pedido ni pago. No enviamos correos ni prometemos una respuesta.</p>
      </section>

      <section aria-labelledby="commission-form-title">
        <h2 id="commission-form-title">Solicitud de encargo</h2>
        <p class="commission-form__status" id="product-status" role="status" aria-live="polite">Cargando el catálogo para asociar una pieza (opcional)…</p>
        <form class="commission-form" id="commission-form">
          <p class="commission-form__status" id="product-unavailable" role="status" aria-live="polite" hidden>Ahora no podemos cargar el catálogo. Igual podés enviar tu idea sin asociarla a un producto.</p>
          <div class="commission-form__field">
            <label class="commission-form__label" for="commission-name">Nombre</label>
            <input class="commission-form__control" id="commission-name" name="name" autocomplete="name" required maxlength="100" />
          </div>
          <div class="commission-form__field">
            <label class="commission-form__label" for="commission-email">Correo electrónico</label>
            <input class="commission-form__control" id="commission-email" name="email" type="email" autocomplete="email" required maxlength="254" />
          </div>
          <div class="commission-form__field">
            <label class="commission-form__label" for="commission-idea">Tu idea</label>
            <textarea class="commission-form__control commission-form__control--textarea" id="commission-idea" name="idea" required maxlength="5000" rows="6"></textarea>
          </div>
          <div class="commission-form__field">
            <label class="commission-form__label" for="commission-product">Asociar una pieza (opcional)</label>
            <select class="commission-form__control" id="commission-product" name="idProduct" disabled>
              <option value="">Sin asociar</option>
            </select>
          </div>
          <p class="commission-form__disclosure">La solicitud se guarda en esta demo local para revisión por personas con rol STAFF o ADMIN. Se oculta a los 30 días y se elimina físicamente cada hora mientras el backend está activo; si estuvo detenido, se elimina en el próximo inicio. <a href="/privacy">Leé la política de privacidad</a>.</p>
          <button class="commission-form__submit" type="submit">Enviar idea</button>
          <p class="commission-form__status" id="commission-feedback" role="status" aria-live="polite"></p>
        </form>
      </section>
    </article>
  </main>
</Layout>

<script>
  import { fetchProducts } from '../domains/products/services/product.service';
  import { submitCustomCommissionRequest } from '../domains/commissions/services/customCommissionRequest.service';

  const form = document.querySelector<HTMLFormElement>('#commission-form');
  const productSelect = document.querySelector<HTMLSelectElement>('#commission-product');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const productStatus = document.querySelector<HTMLElement>('#product-status');
  const submitLabel = submitButton?.textContent ?? 'Enviar idea';
  const productUnavailable = document.querySelector<HTMLElement>('#product-unavailable');
  const feedback = document.querySelector<HTMLElement>('#commission-feedback');

  async function loadProductChoices(): Promise<void> {
    if (!productSelect || !submitButton || !productStatus || !productUnavailable) return;
    try {
      const result = await fetchProducts();
      if (!result.ok || result.products.length === 0) {
        productStatus.hidden = true;
        productUnavailable.hidden = false;
      } else {
        for (const product of result.products) {
          const option = document.createElement('option');
          option.value = String(product.id);
          option.textContent = product.name;
          productSelect.append(option);
        }
        productStatus.textContent = 'Elegí una pieza si querés asociarla; también podés enviar la idea sin hacerlo.';
        productSelect.disabled = false;
      }
    } catch {
      productStatus.hidden = true;
      productUnavailable.hidden = false;
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitButton || !feedback || !form.reportValidity()) return;
    const data = new FormData(form);
    const idProduct = String(data.get('idProduct') ?? '');
    form.setAttribute('aria-busy', 'true');
    submitButton.disabled = true;
    submitButton.textContent = 'Enviando…';
    feedback.setAttribute('role', 'status');
    feedback.textContent = 'Enviando…';
    let result: Awaited<ReturnType<typeof submitCustomCommissionRequest>>;
    try {
      result = await submitCustomCommissionRequest({
        name: String(data.get('name')),
        email: String(data.get('email')),
        idea: String(data.get('idea')),
        ...(idProduct ? { idProduct: Number(idProduct) } : {}),
      });
    } finally {
      form.removeAttribute('aria-busy');
      submitButton.disabled = false;
      submitButton.textContent = submitLabel;
    }
    if (result.ok) {
      form.reset();
      feedback.textContent = 'Listo: tu solicitud quedó guardada en esta demo local para revisión. No es un pedido, presupuesto ni pago; no enviamos un correo ni prometemos una respuesta. Se oculta a los 30 días y se purga cada hora mientras el backend está activo o al próximo inicio si estuvo detenido.';
      return;
    }
    feedback.setAttribute('role', 'alert');
    feedback.textContent = {
      validation: `No pudimos aceptar esos datos. Revisalos y volvé a intentar.${idProduct ? ' Si elegiste una pieza, puede que ya no esté disponible: elegí “Sin asociar” y volvé a enviar.' : ''}`,
      'rate-limit': 'Se recibieron demasiados intentos. Esperá un rato antes de volver a probar.',
      network: 'No pudimos conectar. Revisá tu conexión e intentá de nuevo.',
      server: 'No se pudo guardar la solicitud ahora. Intentá de nuevo más tarde.',
    }[result.reason];
  });

  void loadProductChoices();
</script>

<style>
  .commission-form {
    display: grid;
    gap: var(--space-lg);
    max-width: 42rem;
  }

  .commission-form__field {
    display: grid;
    gap: var(--space-xs);
  }

  .commission-form__label {
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
  }

  .commission-form__control {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border);
    background: var(--input-bg);
    color: var(--input-fg);
    font: inherit;
  }

  .commission-form__control:focus-visible,
  .commission-form__submit:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .commission-form__control--textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .commission-form__control:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .commission-form__submit {
    justify-self: start;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  .commission-form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .commission-form__status {
    color: var(--fg);
  }

  .commission-form__status[role="alert"] {
    color: var(--danger-text);
  }

  .commission-form__disclosure {
    max-width: 70ch;
  }

  @media (max-width: 640px) {
    .commission-form {
      width: 100%;
    }

    .commission-form__submit {
      width: 100%;
    }
  }
</style>
