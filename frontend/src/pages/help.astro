---
import EditorialSidebar from '../components/EditorialSidebar.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Encargos — Mundo 3D">
  <main class="editorial-page">
    <div class="editorial-shell">
      <EditorialSidebar currentPath={Astro.url.pathname} />

      <article class="editorial-article">
        <header class="editorial-header">
          <h1>Contanos tu idea</h1>
          <p class="editorial-lead">
            Podés dejar una solicitud de encargo sin crear cuenta. Es una demo interactiva:
            guardamos tu idea para revisión interna, sin presupuesto, pedido, pago ni correo
            automático. Usá datos ficticios al probar.
          </p>
        </header>

        <section class="editorial-section" aria-labelledby="commission-form-title">
          <h2 id="commission-form-title">Solicitud de encargo</h2>

          <div class="editorial-form-surface">
            <p class="commission-form__status" id="product-status" role="status" aria-live="polite">
              Cargando el catálogo para asociar una pieza (opcional)…
            </p>
            <form class="commission-form" id="commission-form" action="/help" method="post">
              <p
                class="commission-form__status"
                id="product-unavailable"
                role="status"
                aria-live="polite"
                hidden
              >
                Ahora no podemos cargar el catálogo. Igual podés enviar tu idea sin asociarla a un
                producto.
              </p>
              <div class="commission-form__field">
                <label class="commission-form__label" for="commission-name">Nombre</label>
                <input
                  class="commission-form__control"
                  id="commission-name"
                  name="name"
                  autocomplete="name"
                  required
                  maxlength="100"
                />
              </div>
              <div class="commission-form__field">
                <label class="commission-form__label" for="commission-email"
                  >Correo electrónico</label
                >
                <input
                  class="commission-form__control"
                  id="commission-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  maxlength="254"
                />
              </div>
              <div class="commission-form__field">
                <label class="commission-form__label" for="commission-idea">Tu idea</label>
                <textarea
                  class="commission-form__control commission-form__control--textarea"
                  id="commission-idea"
                  name="idea"
                  required
                  maxlength="5000"
                  rows="6"
                ></textarea>
              </div>
              <div class="commission-form__field">
                <label class="commission-form__label" for="commission-product"
                  >Asociar una pieza (opcional)</label
                >
                <select
                  class="commission-form__control"
                  id="commission-product"
                  name="idProduct"
                  disabled
                >
                  <option value="">Sin asociar</option>
                </select>
              </div>
              <p class="commission-form__disclosure">
                La solicitud se guarda en esta demo para revisión por personas con rol{' '}
                <code>STAFF</code> o <code>ADMIN</code>. Se oculta a los 30 días y se elimina
                físicamente cada hora mientras el backend está activo; si estuvo detenido, se
                elimina en el próximo inicio. <a href="/privacy">Leé la política de privacidad</a>.
              </p>
              <button class="commission-form__submit" type="submit" disabled>Enviar idea</button>
              <p
                class="commission-form__status commission-form__status--feedback"
                id="commission-feedback"
                role="status"
                aria-live="polite"
              ></p>
            </form>
          </div>
        </section>
      </article>
    </div>
  </main>
</Layout>

<script>
  import { fetchProducts } from '../domains/products/services/product.service';
  import { submitCustomCommissionRequest } from '../domains/commissions/services/customCommissionRequest.service';

  const form = document.querySelector<HTMLFormElement>('#commission-form');
  const productSelect = document.querySelector<HTMLSelectElement>('#commission-product');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const productStatus = document.querySelector<HTMLElement>('#product-status');
  const submitLabel = submitButton?.textContent ?? 'Enviar idea';
  const productUnavailable = document.querySelector<HTMLElement>('#product-unavailable');
  const feedback = document.querySelector<HTMLElement>('#commission-feedback');

  async function loadProductChoices(): Promise<void> {
    if (!productSelect || !submitButton || !productStatus || !productUnavailable) return;
    try {
      const result = await fetchProducts();
      if (!result.ok || result.products.length === 0) {
        productStatus.hidden = true;
        productUnavailable.hidden = false;
      } else {
        for (const product of result.products) {
          const option = document.createElement('option');
          option.value = String(product.id);
          option.textContent = product.name;
          productSelect.append(option);
        }
        productStatus.textContent =
          'Elegí una pieza si querés asociarla; también podés enviar la idea sin hacerlo.';
        productSelect.disabled = false;
      }
    } catch {
      productStatus.hidden = true;
      productUnavailable.hidden = false;
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitButton || !feedback || !form.reportValidity()) return;
    const data = new FormData(form);
    const idProduct = String(data.get('idProduct') ?? '');
    form.setAttribute('aria-busy', 'true');
    submitButton.disabled = true;
    submitButton.textContent = 'Enviando…';
    feedback.setAttribute('role', 'status');
    feedback.dataset.state = 'pending';
    feedback.textContent = 'Enviando…';
    let result: Awaited<ReturnType<typeof submitCustomCommissionRequest>>;
    try {
      result = await submitCustomCommissionRequest({
        name: String(data.get('name')),
        email: String(data.get('email')),
        idea: String(data.get('idea')),
        ...(idProduct ? { idProduct: Number(idProduct) } : {}),
      });
    } finally {
      form.removeAttribute('aria-busy');
      submitButton.disabled = false;
      submitButton.textContent = submitLabel;
    }
    if (result.ok) {
      form.reset();
      feedback.setAttribute('role', 'status');
      feedback.dataset.state = 'success';
      feedback.textContent =
        'Listo: tu solicitud quedó guardada en esta demo para revisión. No es un pedido, presupuesto ni pago; no enviamos un correo ni prometemos una respuesta. Se oculta a los 30 días y se purga cada hora mientras el backend está activo o al próximo inicio si estuvo detenido.';
      return;
    }
    feedback.setAttribute('role', 'alert');
    feedback.dataset.state = 'error';
    feedback.textContent = {
      validation: `No pudimos aceptar esos datos. Revisalos y volvé a intentar.${idProduct ? ' Si elegiste una pieza, puede que ya no esté disponible: elegí “Sin asociar” y volvé a enviar.' : ''}`,
      'rate-limit': 'Se recibieron demasiados intentos. Esperá un rato antes de volver a probar.',
      network: 'No pudimos conectar. Revisá tu conexión e intentá de nuevo.',
      server: 'No se pudo guardar la solicitud ahora. Intentá de nuevo más tarde.',
    }[result.reason];
  });

  if (form && submitButton) submitButton.disabled = false;
  void loadProductChoices();
</script>

<style>
  .commission-form {
    display: grid;
    gap: var(--space-lg);
    max-width: 42rem;
  }

  .commission-form__field {
    display: grid;
    gap: var(--space-xs);
  }

  .commission-form__label {
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .commission-form__control {
    box-sizing: border-box;
    width: 100%;
    min-block-size: var(--sys-target-min, 44px);
    padding: 10px 12px;
    border: 1px solid var(--input-border);
    border-radius: var(--radius-control);
    background: var(--input-bg);
    color: var(--input-fg);
    font: 400 0.9375rem / 1.4 var(--font-body);
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  select.commission-form__control {
    cursor: pointer;
  }

  .commission-form__control::placeholder {
    color: var(--sys-text-muted);
    opacity: 1;
  }

  .commission-form__control:hover:not(:disabled):not(:focus) {
    border-color: var(--sys-text-muted);
  }

  .commission-form__control:focus {
    outline: none;
    border-color: var(--accent-strong);
    box-shadow: 0 0 0 3px var(--accent-tint);
  }

  .commission-form__control:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent-strong);
    box-shadow: 0 0 0 3px var(--accent-tint);
  }

  .commission-form__control--textarea {
    min-block-size: 9rem;
    resize: vertical;
  }

  .commission-form__control:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .commission-form__submit {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-block-size: var(--sys-target-min, 44px);
    padding: 10px 18px;
    border: 1px solid var(--accent-strong);
    border-radius: var(--radius-control);
    background: var(--accent-strong);
    color: #ffffff;
    box-shadow: var(--shadow-button-primary);
    cursor: pointer;
    touch-action: manipulation;
    font: 600 0.9375rem / 1.2 var(--font-body);
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .commission-form__submit:hover:not(:disabled) {
    background: var(--accent-strong-hover);
    border-color: var(--accent-strong-hover);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .commission-form__submit:active:not(:disabled) {
    background: var(--accent-strong-active);
    border-color: var(--accent-strong-active);
    color: #ffffff;
    transform: translateY(0);
  }

  .commission-form__submit:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .commission-form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    box-shadow: none;
    transform: none;
  }

  .commission-form__status {
    color: var(--fg);
    font-size: 0.9375rem;
  }

  .commission-form__status[role='alert'] {
    color: var(--danger-text);
  }

  .commission-form__status--feedback {
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface-subtle);
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .commission-form__status--feedback:empty {
    display: none;
  }

  .commission-form__status--feedback[data-state='success'] {
    background: var(--success-bg);
    border-color: var(--success-border);
    color: var(--success-text);
  }

  .commission-form__status--feedback[role='alert'] {
    background: var(--danger-bg);
    border-color: var(--danger-border);
    color: var(--danger-text);
  }

  .commission-form__disclosure {
    font-size: 0.9375rem;
    color: var(--editorial-muted);
    max-width: var(--editorial-prose-max, 58ch);
  }

  @media (max-width: 639px) {
    .commission-form {
      width: 100%;
    }

    .commission-form__submit {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .commission-form__control,
    .commission-form__submit {
      transition: none;
    }

    .commission-form__submit:hover:not(:disabled),
    .commission-form__submit:active:not(:disabled) {
      transform: none;
    }
  }
</style>
