---
import Layout from '../layouts/Layout.astro';
import SocialIcon from '../components/SocialIcon.astro';
---

<Layout title="Detalle del producto - Mundo 3D">
  <main class="product-detail__main" aria-label="Detalle del producto">
    <div class="product-detail__card">
      <div class="product-detail__utility-anchor">
        <div class="product-detail__utility-row">
          <a href="/products" class="product-detail__back-link">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6M9 12h11" /></svg>
            Volver al catálogo
          </a>
          <button
            id="share-product-btn"
            type="button"
            class="product-detail__share-button"
            aria-expanded="false"
            aria-controls="share-panel"
            aria-haspopup="dialog"
            hidden
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="19" r="2.5" /><path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5" /></svg>
            Compartir
          </button>
        </div>

        <section id="share-panel" class="product-share-panel" role="dialog" aria-labelledby="share-panel-title" hidden>
          <div class="product-share-panel__header">
            <div class="product-share-panel__heading">
              <h2 id="share-panel-title" class="product-share-panel__title">Compartir pieza</h2>
              <p id="share-panel-summary" class="product-share-panel__summary"></p>
            </div>
            <button type="button" id="share-panel-close" class="product-share-panel__close" aria-label="Cerrar panel de compartir">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
          </div>
          <div class="product-share-panel__copy-group">
            <label class="sr-only" for="share-url-input">Enlace de la pieza</label>
            <input id="share-url-input" class="product-share-panel__url-input" type="url" readonly />
            <button type="button" id="share-copy-btn" class="product-share-panel__copy-btn">Copiar</button>
          </div>
          <div class="product-share-panel__channels">
            <a id="share-whatsapp-link" class="product-share-panel__channel" target="_blank" rel="noopener noreferrer">
              <SocialIcon name="whatsapp" size={16} />
              WhatsApp
            </a>
            <a id="share-email-link" class="product-share-panel__channel">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
              Correo
            </a>
            <button type="button" id="share-native-btn" class="product-share-panel__channel product-share-panel__channel--full" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 16V4m0 0-4 4m4-4 4 4M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
              Más opciones…
            </button>
          </div>
          <p id="share-status" class="product-share-panel__status" role="status" aria-live="polite"></p>
        </section>
      </div>

      <section id="product-loading" class="product-detail__state" role="status" aria-live="polite" aria-busy="true">
        <h1 class="product-detail__state-title">Cargando detalle del producto…</h1>
        <div class="product-detail__skeleton" aria-hidden="true">
          <span class="product-detail__skeleton-image"></span>
          <span class="product-detail__skeleton-info"></span>
          <span class="product-detail__skeleton-specs"></span>
          <span class="product-detail__skeleton-action"></span>
        </div>
      </section>

      <div id="product-content" aria-busy="true" hidden>
        <div class="product-detail__media">
          <img id="product-img" src="/images/illustrations/Otras.svg" alt="" class="product-detail__image" />
        </div>
        <section class="product-detail__info" aria-label="Información del producto">
          <h1 class="product-detail__title" id="product-title"><span id="product-name">Detalle del producto</span></h1>
          <p class="price price--lg" id="product-price"></p>
          <p class="product-detail__description" id="product-description"></p>
          <section class="product-specs" aria-label="Especificaciones 3D">
            <table class="product-specs__table">
              <caption class="sr-only">Características de fabricación del producto</caption>
              <tbody>
                <tr><th class="product-specs__label" scope="row">Material</th><td class="product-specs__value" id="product-material">-</td></tr>
                <tr><th class="product-specs__label" scope="row">Dimensiones</th><td class="product-specs__value" id="product-dimensions">-</td></tr>
                <tr><th class="product-specs__label" scope="row">Acabado</th><td class="product-specs__value" id="product-finish">-</td></tr>
                <tr><th class="product-specs__label" scope="row">Tiempo de producción</th><td class="product-specs__value" id="product-production">-</td></tr>
              </tbody>
            </table>
          </section>
          <p id="product-specs-inquiry" class="product-specs__inquiry" hidden>
            ¿Querés consultar medidas, material o pedir una variante? <a href="/help">Escribinos en Encargos</a>.
          </p>
          <div class="product-detail__actions">
            <button id="add-to-cart-btn" type="button" class="product-detail__action product-detail__action--primary">Agregar al carrito</button>
            <a href="/cart" class="product-detail__action product-detail__action--secondary">Ir al carrito</a>
          </div>
          <p class="product-detail__demo-note">Pedido simulado: no procesa cobros ni envíos reales.</p>
          <p id="cart-status" class="product-detail__status-copy" aria-live="polite"></p>
        </section>
      </div>

      <section id="product-error" class="product-detail__state" role="alert" hidden>
        <h1 id="product-error-title" class="product-detail__state-title">Producto no encontrado</h1>
        <p id="product-error-copy">No encontramos el producto que buscás.</p>
        <div class="product-detail__state-actions">
          <button type="button" id="product-retry-btn" class="product-detail__action product-detail__action--primary" hidden>Reintentar</button>
          <a href="/products" class="product-detail__action product-detail__action--secondary product-detail__recovery-link">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6M9 12h11" /></svg>
            Volver al catálogo
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { getCategoryImg, isPlaceholderImage } from '../domains/products';
  import { resolveImageUrl } from '../lib/imageUrl';
  import { fetchProductById } from '../domains/products/services/product.service';
  import { CartService } from '../domains/cart';
  import { setupProductShare } from '../scripts/productShare';

  const priceFormatter = new Intl.NumberFormat('es-AR');
  let shareCleanup: (() => void) | undefined;

  function formatPrice(value: number): string {
    return `$ ${priceFormatter.format(value)}`;
  }

  function getProductId(): string | null {
    const fromQuery = new URLSearchParams(window.location.search).get('id');
    if (fromQuery) return fromQuery;
    const parts = window.location.pathname.split('/').filter(Boolean);
    return parts[0] === 'product' && parts[1] ? parts[1] : null;
  }

  function showError(reason: 'not-found' | 'network' | 'server'): void {
    const get = (id: string) => document.getElementById(id);
    const loading = get('product-loading');
    const content = get('product-content');
    const error = get('product-error');
    const retryButton = get('product-retry-btn') as HTMLButtonElement | null;

    if (loading) loading.hidden = true;
    if (content) content.hidden = true;
    if (error) error.hidden = false;
    if (retryButton) retryButton.hidden = reason === 'not-found';

    const title = reason === 'not-found' ? 'Producto no encontrado' : 'No pudimos cargar el producto';
    if (get('product-error-title')) get('product-error-title')!.textContent = title;

    const copy =
      reason === 'not-found'
        ? 'No encontramos el producto que buscás.'
        : reason === 'network'
          ? 'Revisá tu conexión e intentá de nuevo.'
          : 'El servidor no pudo responder. Intentá de nuevo en unos minutos.';
    if (get('product-error-copy')) get('product-error-copy')!.textContent = copy;
  }

  async function loadProduct(): Promise<void> {
    const productId = getProductId();
    if (!productId) return showError('not-found');
    const result = await fetchProductById(productId);
    if (!result.ok) return showError(result.reason);

    const { product } = result;
    const get = (id: string) => document.getElementById(id);
    const setText = (id: string, value: string) => {
      const node = get(id);
      if (node) node.textContent = value;
    };

    const imageElement = get('product-img') as HTMLImageElement | null;
    const content = get('product-content');
    const addButton = get('add-to-cart-btn') as HTMLButtonElement | null;
    const shareButton = get('share-product-btn') as HTMLButtonElement | null;
    const inquiryEl = get('product-specs-inquiry');
    const priceLabel = formatPrice(product.price);

    setText('product-name', product.name);
    setText('product-price', priceLabel);
    setText('product-description', product.description.trim() || 'Este producto todavía no tiene una descripción disponible.');
    setText('product-material', product.material);
    setText('product-finish', product.finish);
    setText('product-production', product.productionTime);
    setText('product-dimensions', product.hasDimensions ? `H: ${product.height} | W: ${product.width} | D: ${product.depth}` : 'A consultar');

    if (inquiryEl) {
      const hasConsultSpec = [
        product.material,
        product.height,
        product.width,
        product.depth,
        product.finish,
        product.productionTime,
      ].some((value) => !value.trim() || value === 'A consultar' || value === 'no definida');
      inquiryEl.hidden = !hasConsultSpec;
    }

    const placeholder = isPlaceholderImage(product.image);
    const categoryImage = `/images/illustrations/${getCategoryImg(product.category)}.svg`;
    const initialImageSrc = placeholder ? categoryImage : resolveImageUrl(product.image, 'products');
    let fallbackCartImage: string | null = placeholder ? initialImageSrc : null;

    if (imageElement) {
      imageElement.src = initialImageSrc;
      imageElement.alt = placeholder ? `Ilustración de ${product.category} para ${product.name}` : product.name;
      imageElement.addEventListener('error', () => {
        fallbackCartImage = '/images/illustrations/Otras.svg';
        imageElement.src = fallbackCartImage;
        imageElement.alt = `Ilustración genérica para ${product.name}`;
      }, { once: true });
    }

    document.title = `${product.name} - Mundo 3D`;
    const loading = get('product-loading');
    const error = get('product-error');
    if (error) error.hidden = true;
    if (loading) loading.hidden = true;
    if (content) {
      content.hidden = false;
      content.setAttribute('aria-busy', 'false');
    }
    if (shareButton) shareButton.hidden = false;

    addButton?.addEventListener('click', () => {
      const status = get('cart-status');
      let resetTimer: number | undefined;
      const resetButton = () => {
        addButton.textContent = 'Agregar al carrito';
        addButton.disabled = false;
        addButton.classList.remove('product-detail__action--confirmed');
      };
      const onSyncError = (event: Event) => {
        if (resetTimer !== undefined) window.clearTimeout(resetTimer);
        const message = (event as CustomEvent<{ message?: string }>).detail?.message;
        if (status) {
          status.setAttribute('role', 'alert');
          status.textContent = message || 'No pudimos agregar el producto al carrito.';
        }
        resetButton();
      };

      if (status) status.removeAttribute('role');
      if (CartService.hasToken()) {
        window.addEventListener('cart-sync-error', onSyncError, { once: true });
      }
      CartService.addToCart(fallbackCartImage ? { ...product, image: fallbackCartImage } : product);
      addButton.disabled = true;
      addButton.classList.add('product-detail__action--confirmed');
      addButton.textContent = 'Agregado al carrito';
      setText('cart-status', `${product.name} se agregó al carrito.`);
      resetTimer = window.setTimeout(() => {
        window.removeEventListener('cart-sync-error', onSyncError);
        resetButton();
      }, 2000);
    });

    const sharePanel = get('share-panel');
    const shareClose = get('share-panel-close') as HTMLButtonElement | null;
    const shareSummary = get('share-panel-summary');
    const shareUrlInput = get('share-url-input') as HTMLInputElement | null;
    const shareCopyBtn = get('share-copy-btn') as HTMLButtonElement | null;
    const shareWhatsappLink = get('share-whatsapp-link') as HTMLAnchorElement | null;
    const shareEmailLink = get('share-email-link') as HTMLAnchorElement | null;
    const shareNativeBtn = get('share-native-btn') as HTMLButtonElement | null;
    const shareStatus = get('share-status');
    const shareAnchor = document.querySelector('.product-detail__utility-anchor') as HTMLElement | null;

    if (
      shareButton &&
      sharePanel &&
      shareClose &&
      shareUrlInput &&
      shareCopyBtn &&
      shareWhatsappLink &&
      shareEmailLink &&
      shareNativeBtn
    ) {
      shareCleanup?.();
      shareCleanup = setupProductShare(
        {
          anchor: shareAnchor,
          triggerButton: shareButton,
          panel: sharePanel,
          closeButton: shareClose,
          summaryEl: shareSummary,
          urlInput: shareUrlInput,
          copyButton: shareCopyBtn,
          whatsappLink: shareWhatsappLink,
          emailLink: shareEmailLink,
          nativeButton: shareNativeBtn,
          statusEl: shareStatus,
        },
        {
          productId: product.id,
          name: product.name,
          priceLabel,
        },
      );
    }
  }

  document.getElementById('product-retry-btn')?.addEventListener('click', () => {
    const error = document.getElementById('product-error');
    const loading = document.getElementById('product-loading');
    if (error) error.hidden = true;
    if (loading) loading.hidden = false;
    loadProduct().catch(() => showError('network'));
  });

  loadProduct().catch(() => showError('network'));
</script>
