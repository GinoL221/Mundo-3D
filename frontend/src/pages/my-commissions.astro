---
import Layout from '../layouts/Layout.astro';
import '../styles/components/my-commissions.css';
---

<Layout title="Mis encargos — Mundo 3D">
  <main class="my-commissions system-frame system-section">
    <header class="ui-page-head">
      <div class="ui-page-head__main">
        <h1 class="ui-page-head__title">Mis encargos</h1>
        <p class="ui-page-head__scope">
          Consultá las solicitudes de encargo que enviaste con tu cuenta. Se conservan durante 30
          días para revisión manual del taller.
        </p>
      </div>
      <div class="ui-page-head__actions">
        <a href="/help#encargos" class="ui-btn ui-btn--primary">Nuevo encargo</a>
      </div>
    </header>

    <section
      id="my-commissions-region"
      class="my-commissions__region"
      aria-busy="true"
      aria-label="Historial de encargos"
    >
      <div
        id="my-commissions-loading"
        class="ui-state"
        role="status"
        aria-live="polite"
        aria-busy="true"
      >
        <p class="ui-state__title">Cargando tus encargos</p>
        <p class="ui-state__text">Consultando las solicitudes enviadas desde tu cuenta.</p>
        <div class="ui-skeleton-list" aria-hidden="true">
          <span class="ui-skeleton"></span>
          <span class="ui-skeleton ui-skeleton--medium"></span>
          <span class="ui-skeleton ui-skeleton--short"></span>
        </div>
      </div>

      <div id="my-commissions-guest" class="ui-state ui-state--empty ui-state--open" hidden>
        <svg
          class="ui-state__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <h2 class="ui-state__title">Iniciá sesión para ver tus encargos</h2>
        <p class="ui-state__text">
          Podés enviar encargos sin cuenta, pero necesitás iniciar sesión como Comprador para
          consultar tu historial personal.
        </p>
        <div class="my-commissions__actions">
          <a class="ui-btn ui-btn--primary" href="/login">Iniciar sesión</a>
          <a class="ui-btn ui-btn--secondary" href="/help#encargos">Enviar encargo sin cuenta</a>
        </div>
      </div>

      <div id="my-commissions-operational" class="ui-callout ui-callout--info" role="status" hidden>
        <svg
          class="ui-callout__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 16v-4"></path>
          <path d="M12 8h.01"></path>
        </svg>
        <div class="ui-callout__content">
          <p class="ui-callout__title">Las cuentas del taller no tienen encargos personales</p>
          <p class="ui-callout__text">
            Tu sesión actual es operativa (Taller o Admin). Para revisar todas las solicitudes
            recibidas entrá a la bandeja del taller.
          </p>
          <div class="ui-callout__actions">
            <a class="ui-btn ui-btn--primary ui-btn--sm" href="/admin/commission-requests">
              Ir a Solicitudes recibidas
            </a>
            <a class="ui-btn ui-btn--secondary ui-btn--sm" href="/admin/orders">
              Ir a Pedidos del taller
            </a>
          </div>
        </div>
      </div>

      <div id="my-commissions-error" class="ui-callout ui-callout--danger" role="alert" hidden>
        <svg
          class="ui-callout__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m15 9-6 6"></path>
          <path d="m9 9 6 6"></path>
        </svg>
        <div class="ui-callout__content">
          <p class="ui-callout__title">No pudimos cargar tus encargos</p>
          <p id="my-commissions-error-text" class="ui-callout__text">
            El servicio no respondió a tiempo. Volvé a intentar en unos segundos.
          </p>
          <div class="ui-callout__actions">
            <button
              id="my-commissions-retry"
              type="button"
              class="ui-btn ui-btn--secondary ui-btn--sm"
            >
              Reintentar
            </button>
          </div>
        </div>
      </div>

      <div
        id="my-commissions-empty"
        class="ui-state ui-state--empty ui-state--open"
        role="status"
        aria-live="polite"
        hidden
      >
        <svg
          class="ui-state__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        <h2 class="ui-state__title">Todavía no enviaste encargos con tu cuenta</h2>
        <p class="ui-state__text">
          Contanos qué pieza querés imprimir o personalizar y vas a poder seguir tus solicitudes acá
          durante 30 días.
        </p>
        <div class="my-commissions__actions">
          <a class="ui-btn ui-btn--primary" href="/help#encargos">Pedir un encargo</a>
        </div>
      </div>

      <ul
        id="my-commissions-list"
        class="ui-inbox"
        aria-label="Tus solicitudes de encargo"
        hidden
      >
      </ul>
    </section>
  </main>
</Layout>

<script>
  import { initializeMyCommissions } from '../scripts/myCommissions';

  void initializeMyCommissions(document);
</script>
