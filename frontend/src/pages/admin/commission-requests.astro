---
import Layout from '../../layouts/Layout.astro';
import '../../styles/components/admin-commission-requests.css';
---

<Layout title="Solicitudes de encargo — Mundo 3D">
  <main class="admin-inbox system-frame system-section">
    <header class="ui-page-head">
      <div class="ui-page-head__main">
        <div class="ui-page-head__title-row">
          <h1 class="ui-page-head__title">Solicitudes de encargo</h1>
          <span id="admin-role-badge" class="ui-badge" hidden></span>
        </div>
        <p id="admin-requests-scope" class="ui-page-head__scope" hidden>
          Revisión manual del taller: no envía correos automáticos ni genera presupuestos o
          pedidos. Cada solicitud se purga automáticamente a los 30 días.
        </p>
      </div>
    </header>

    <div
      id="admin-gate-denied"
      class="ui-callout"
      role="alert"
      aria-labelledby="admin-gate-denied-title"
      hidden
    >
      <svg
        class="ui-callout__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="11" width="18" height="11" rx="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <div class="ui-callout__content">
        <p id="admin-gate-denied-title" class="ui-callout__title">
          Acceso restringido al panel del taller
        </p>
        <p class="ui-callout__text">
          No tenés permisos para acceder a esta sección. Necesitás una sesión con rol Taller o
          Admin validada por el servidor.
        </p>
        <div class="ui-callout__actions">
          <a href="/products" class="ui-btn ui-btn--secondary ui-btn--sm">Volver al Catálogo</a>
          <a href="/" class="ui-btn ui-btn--ghost ui-btn--sm">Ir al inicio</a>
        </div>
      </div>
    </div>

    <section
      id="admin-requests-content"
      class="admin-inbox__content"
      aria-label="Bandeja de solicitudes"
      hidden
    >
      <div
        id="admin-requests-loading"
        class="ui-state"
        role="status"
        aria-live="polite"
        aria-busy="true"
      >
        <p class="ui-state__title">Cargando solicitudes de encargo</p>
        <p class="ui-state__text">Consultando la bandeja del taller y tus permisos de sesión.</p>
        <div class="ui-skeleton-list" aria-hidden="true">
          <span class="ui-skeleton"></span>
          <span class="ui-skeleton ui-skeleton--medium"></span>
          <span class="ui-skeleton ui-skeleton--short"></span>
        </div>
      </div>

      <div id="admin-requests-error" class="ui-callout ui-callout--danger" role="alert" hidden>
        <svg
          class="ui-callout__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m15 9-6 6"></path>
          <path d="m9 9 6 6"></path>
        </svg>
        <div class="ui-callout__content">
          <p class="ui-callout__title">No pudimos cargar las solicitudes de encargo</p>
          <p id="admin-requests-error-text" class="ui-callout__text">
            El servicio no respondió a tiempo. Volvé a intentar en unos segundos.
          </p>
          <div class="ui-callout__actions">
            <button
              id="admin-requests-retry"
              type="button"
              class="ui-btn ui-btn--secondary ui-btn--sm"
            >
              Reintentar
            </button>
          </div>
        </div>
      </div>

      <div
        id="admin-requests-empty"
        class="ui-state ui-state--empty"
        role="status"
        aria-live="polite"
        hidden
      >
        <svg
          class="ui-state__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        <p class="ui-state__title">No hay solicitudes de encargo pendientes</p>
        <p class="ui-state__text">
          Cuando alguien envíe una consulta desde Encargos a medida va a aparecer acá para
          revisión manual durante 30 días.
        </p>
      </div>

      <ul
        id="admin-requests-list"
        class="ui-inbox"
        aria-label="Solicitudes de encargo recibidas"
        hidden
      >
      </ul>
    </section>
  </main>
</Layout>

<script>
  import { initializeAdminCommissionRequests } from '../../scripts/adminCommissionRequests';

  void initializeAdminCommissionRequests(document, window);
</script>
