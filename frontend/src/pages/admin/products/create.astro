---
import Layout from '../../../layouts/Layout.astro';
import AdminGateDenied from '../../../domains/products/components/admin/AdminGateDenied.astro';
import AdminProductForm from '../../../domains/products/components/admin/AdminProductForm.astro';
import '../../../styles/components/admin-products.css';
---

<Layout title="Nueva pieza — Mundo 3D">
  <main>
    <div class="admin-shell">
      <!--
        Client-side UX gate only (visual-admin-hiding spec) — the API's
        requireRoles guard (ADMIN, STAFF) on POST /api/products is the real
        security boundary, not this check.
      -->
      <AdminGateDenied />

      <div id="admin-create-content" class="admin-form-shell" hidden>
        <a href="/admin/products" class="admin-back-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          <span>Volver al Catálogo</span>
        </a>

        <header class="ui-page-head">
          <div class="ui-page-head__main">
            <div class="ui-page-head__title-row">
              <h1 class="ui-page-head__title">Nueva pieza</h1>
              <span id="admin-role-badge" class="ui-badge ui-badge--staff">STAFF</span>
            </div>
            <p id="admin-scope-text" class="ui-page-head__scope">
              Cargá una nueva pieza en el Catálogo del taller.
            </p>
          </div>
        </header>

        <AdminProductForm
          mode="create"
          formId="create-product-form"
          errorBoxId="create-error"
          submitBtnId="create-btn"
          submitLabel="Crear pieza"
        />
      </div>
    </div>
  </main>
</Layout>

<script>
  import { initializeAdminProductsCreate } from '../../../scripts/adminProductsCreate';

  initializeAdminProductsCreate();
</script>
