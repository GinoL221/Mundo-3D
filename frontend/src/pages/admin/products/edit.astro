---
import Layout from '../../../layouts/Layout.astro';
import AdminGateDenied from '../../../domains/products/components/admin/AdminGateDenied.astro';
import AdminProductForm from '../../../domains/products/components/admin/AdminProductForm.astro';
import '../../../styles/components/admin-products.css';
---

<Layout title="Editar pieza — Mundo 3D">
  <main>
    <div class="admin-shell">
      <!--
        Client-side UX gate only (visual-admin-hiding spec) — the API's
        requireRoles guard (ADMIN, STAFF) on PUT /api/products/:id is the real
        security boundary, not this check.
      -->
      <AdminGateDenied />

      <div id="admin-edit-shell" class="admin-form-shell" hidden>
        <a href="/admin/products" class="admin-back-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          <span>Volver al Catálogo</span>
        </a>

        <header class="ui-page-head">
          <div class="ui-page-head__main">
            <div class="ui-page-head__title-row">
              <h1 class="ui-page-head__title">Editar pieza</h1>
              <span id="admin-role-badge" class="ui-badge ui-badge--staff">STAFF</span>
            </div>
            <p id="admin-scope-text" class="ui-page-head__scope">
              Actualizá los datos de la pieza en el Catálogo. El stock se ajusta desde el listado.
            </p>
          </div>
        </header>

        <div
          id="admin-edit-loading"
          class="ui-state"
          role="status"
          aria-live="polite"
          aria-busy="true"
          hidden
        >
          <p class="ui-state__title">Cargando datos de la pieza</p>
          <p class="ui-state__text">
            Obteniendo información del Catálogo y opciones de clasificación.
          </p>
          <div class="ui-skeleton-list" aria-hidden="true">
            <span class="ui-skeleton"></span>
            <span class="ui-skeleton ui-skeleton--medium"></span>
            <span class="ui-skeleton ui-skeleton--short"></span>
          </div>
        </div>

        <div id="admin-edit-load-error" class="ui-callout ui-callout--danger" role="alert" hidden>
          <svg
            class="ui-callout__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="m15 9-6 6" />
            <path d="m9 9 6 6" />
          </svg>
          <div class="ui-callout__content">
            <p class="ui-callout__title">No pudimos cargar la pieza</p>
            <p id="admin-edit-load-error-text" class="ui-callout__text">
              No se pudo cargar la pieza para editar.
            </p>
            <div class="ui-callout__actions">
              <button
                type="button"
                id="admin-edit-retry"
                class="ui-btn ui-btn--secondary ui-btn--sm"
              >
                Reintentar
              </button>
              <a href="/admin/products" class="ui-btn ui-btn--ghost ui-btn--sm">
                Volver al Catálogo
              </a>
            </div>
          </div>
        </div>

        <!--
          Catalog fields only — this form intentionally has NO stock field.
          PUT /api/products/:id MUST NOT modify stock (product-inventory
          spec, "Product Update"); stock changes go exclusively through the
          stock-adjust control on the admin products list.
        -->
        <div id="admin-edit-content" hidden>
          <AdminProductForm
            mode="edit"
            formId="edit-product-form"
            errorBoxId="edit-error"
            submitBtnId="edit-btn"
            submitLabel="Guardar cambios"
          />
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { initializeAdminProductsEdit } from '../../../scripts/adminProductsEdit';

  initializeAdminProductsEdit();
</script>
