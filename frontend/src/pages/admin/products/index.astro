---
import Layout from '../../../layouts/Layout.astro';
import AdminGateDenied from '../../../domains/products/components/admin/AdminGateDenied.astro';
import '../../../styles/components/admin-products.css';
---

<Layout title="Catálogo del taller — Mundo 3D">
  <main>
    <div class="admin-shell">
      <!--
        Client-side UX gate only (visual-admin-hiding spec): this page is
        shown only when the persisted idRole is ADMIN or STAFF. It is NOT the
        security boundary — the API's requireRoles guard is authoritative.
      -->
      <AdminGateDenied />

      <div id="admin-products-content" class="admin-products__content" hidden>
        <header class="ui-page-head">
          <div class="ui-page-head__main">
            <div class="ui-page-head__title-row">
              <h1 class="ui-page-head__title">Catálogo del taller</h1>
              <span id="admin-role-badge" class="ui-badge ui-badge--staff">Taller</span>
            </div>
            <p id="admin-scope-text" class="ui-page-head__scope">
              Administrá piezas y existencias del Catálogo.
            </p>
          </div>
          <div class="ui-page-head__actions">
            <a href="/admin/products/create" class="ui-btn ui-btn--primary">+ Nueva pieza</a>
          </div>
        </header>

        <div id="admin-status" class="ui-callout ui-callout--success" role="status" aria-live="polite" hidden>
          <svg
            class="ui-callout__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          <div class="ui-callout__content">
            <p id="admin-status-text" class="ui-callout__text"></p>
          </div>
        </div>

        <div id="admin-error" class="ui-callout ui-callout--danger" role="alert" hidden>
          <svg
            class="ui-callout__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="m15 9-6 6" />
            <path d="m9 9 6 6" />
          </svg>
          <div class="ui-callout__content">
            <p class="ui-callout__title">No se pudo completar la acción</p>
            <p id="admin-error-text" class="ui-callout__text"></p>
          </div>
        </div>

        <div
          id="admin-loading-state"
          class="ui-state"
          role="status"
          aria-live="polite"
          aria-busy="true"
        >
          <p class="ui-state__title">Cargando piezas del Catálogo</p>
          <p class="ui-state__text">
            Consultando el inventario del taller y los permisos de tu sesión.
          </p>
          <div class="ui-skeleton-list" aria-hidden="true">
            <span class="ui-skeleton"></span>
            <span class="ui-skeleton ui-skeleton--medium"></span>
            <span class="ui-skeleton ui-skeleton--short"></span>
          </div>
        </div>

        <div id="admin-load-error" class="ui-callout ui-callout--danger" role="alert" hidden>
          <svg
            class="ui-callout__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="m15 9-6 6" />
            <path d="m9 9 6 6" />
          </svg>
          <div class="ui-callout__content">
            <p class="ui-callout__title">No pudimos cargar el Catálogo del taller</p>
            <p class="ui-callout__text">
              El servicio no respondió a tiempo. Tus cambios locales no se perdieron; volvé a
              intentar en unos segundos.
            </p>
            <div class="ui-callout__actions">
              <button
                type="button"
                id="admin-products-retry"
                class="ui-btn ui-btn--secondary ui-btn--sm"
              >
                Reintentar
              </button>
            </div>
          </div>
        </div>

        <div id="admin-empty-state" class="ui-state ui-state--empty" hidden>
          <svg
            class="ui-state__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
            <path d="m3.3 7 8.7 5 8.7-5" />
            <path d="M12 22V12" />
          </svg>
          <p class="ui-state__title">Todavía no hay piezas cargadas</p>
          <p class="ui-state__text">
            Cuando publiques la primera pieza va a aparecer en este listado y en la vitrina pública
            del Catálogo.
          </p>
          <a href="/admin/products/create" class="ui-btn ui-btn--primary">+ Nueva pieza</a>
        </div>

        <div
          id="admin-stock-filters"
          class="admin-stock-filters"
          role="group"
          aria-label="Filtrar catálogo por stock"
          hidden
        >
          <button
            type="button"
            class="admin-stock-filters__btn"
            data-stock-filter="all"
            aria-pressed="true"
          >
            Todos <span class="admin-stock-filters__count" data-stock-count="all">0</span>
          </button>
          <button
            type="button"
            class="admin-stock-filters__btn"
            data-stock-filter="low"
            aria-pressed="false"
          >
            Stock bajo <span class="admin-stock-filters__count" data-stock-count="low">0</span>
          </button>
          <button
            type="button"
            class="admin-stock-filters__btn"
            data-stock-filter="out"
            aria-pressed="false"
          >
            Sin stock <span class="admin-stock-filters__count" data-stock-count="out">0</span>
          </button>
        </div>

        <div id="admin-filter-empty-state" class="ui-state ui-state--empty" role="status" hidden>
          <p id="admin-filter-empty-title" class="ui-state__title">
            No hay piezas en este estado de stock
          </p>
          <p class="ui-state__text">
            Probá cambiar el filtro o volver al listado completo del taller.
          </p>
          <button
            type="button"
            id="admin-filter-reset"
            class="ui-btn ui-btn--secondary ui-btn--sm"
          >
            Ver todas las piezas
          </button>
        </div>

        <div
          id="admin-table-wrap"
          class="ui-table-wrap"
          role="region"
          aria-label="Catálogo del taller"
          tabindex="0"
          hidden
        >
          <table class="ui-table admin-products-table">
            <thead>
              <tr>
                <th scope="col">Pieza</th>
                <th scope="col">Estado</th>
                <th scope="col">Stock</th>
                <th scope="col">Precio</th>
                <th scope="col" class="admin-products-table__actions-head">Acciones</th>
              </tr>
            </thead>
            <tbody id="admin-products-list"></tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <template id="admin-product-row-template">
    <tr class="admin-product-row">
      <td data-cell="piece">
        <div class="admin-products__piece">
          <img
            class="admin-products__thumb"
            src="/images/illustrations/Otras.svg"
            alt=""
            width="48"
            height="48"
            loading="lazy"
          />
          <div class="admin-products__piece-info">
            <span class="admin-product-name"></span>
            <span class="admin-product-meta"></span>
          </div>
        </div>
      </td>
      <td data-label="Estado">
        <span class="ui-badge admin-product-status"></span>
      </td>
      <td data-label="Stock">
        <div class="ui-stepper" role="group" aria-label="Ajustar stock">
          <button type="button" class="ui-stepper__btn admin-product-stock-minus">&#x2212;</button>
          <span class="ui-stepper__value admin-product-stock"></span>
          <button type="button" class="ui-stepper__btn admin-product-stock-plus">+</button>
        </div>
      </td>
      <td data-label="Precio" class="ui-table__num admin-products__price admin-product-price"></td>
      <td data-cell="actions">
        <div class="ui-table__actions">
          <a class="ui-btn ui-btn--secondary ui-btn--sm admin-product-edit">Editar</a>
          <button type="button" class="ui-btn ui-btn--danger-soft ui-btn--sm admin-product-delete">
            Eliminar
          </button>
        </div>
      </td>
    </tr>
  </template>
</Layout>

<script>
  import { initializeAdminProductsList } from '../../../scripts/adminProductsList';

  initializeAdminProductsList();
</script>
