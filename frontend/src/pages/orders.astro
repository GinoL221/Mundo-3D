---
import Layout from '../layouts/Layout.astro';
import { OrderList } from '../domains/orders';
---

<Layout title="Mis pedidos - Mundo 3D">
  <main class="orders-page system-frame system-section">
    <header class="ui-page-head orders-page__head">
      <div class="ui-page-head__main">
        <h1 class="ui-page-head__title">Mis pedidos</h1>
        <p class="ui-page-head__scope">
          Consultá el historial de tus pedidos simulados y entrá al detalle de cada uno.
        </p>
      </div>
    </header>
    <OrderList />
  </main>
</Layout>
