---
import Layout from '../layouts/Layout.astro';
import HomeProductCard from '../domains/products/components/HomeProductCard.astro';
---

<Layout title="Mundo 3D - Inicio" variant="home">
  <main class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="home-eyebrow">TALLER / CATÁLOGO</p>
          <h1 class="home-hero__title" id="home-hero-title">Piezas impresas para tener cerca.</h1>
          <p class="home-hero__description">Figuras, bustos y accesorios nacidos en el taller de Mundo 3D. Elegí una pieza lista o imaginá la próxima con nosotros.</p>
          <div class="home-hero__actions">
            <a class="home-button" href="#catalogo">Ver catálogo →</a>
            <a class="home-text-action" href="#encargos">Pedir un encargo</a>
          </div>
        </div>

        <article class="home-featured-card" aria-label="Pieza destacada">
          <div class="home-featured-card__content" id="home-featured-content">
            <p class="home-featured-card__state" id="home-featured-loading" role="status">
              Cargando la pieza destacada...
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="home-catalogue-intro" id="catalogo" aria-labelledby="catalogue-title">
      <div class="home-catalogue-intro__inner">
        <div class="home-catalogue-intro__copy">
          <p class="home-eyebrow">CATÁLOGO</p>
          <h2 class="home-section-title" id="catalogue-title">Piezas listas para salir del taller</h2>
          <p class="home-section-description">Una selección de figuras, bustos y accesorios impresos para sumar algo único a tu espacio.</p>
        </div>
      </div>
    </section>

    <section class="home-products" id="productos" aria-labelledby="home-products-title">
      <div class="home-products__inner">
        <div class="home-products__meta">
          <h2 class="home-products__title" id="home-products-title">Piezas del catálogo</h2>
          <a class="home-products__link" href="/products">Ver catálogo completo →</a>
        </div>
        <div class="home-products__body" id="home-products-container">
          <p class="home-products__loading" id="home-loading-msg" role="status">Cargando productos...</p>
          <div id="home-products-content" hidden>
            <div class="home-products__grid" id="home-product-grid"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-commission" id="encargos" aria-labelledby="home-commission-title">
      <div class="home-commission__inner">
        <div class="home-commission__copy">
          <p class="home-eyebrow">ENCARGOS A MEDIDA</p>
          <h2 class="home-commission__title" id="home-commission-title">¿Tenés una idea en mente?</h2>
          <p class="home-commission__description">La convertimos en una pieza real, impresa y terminada en el taller.</p>
        </div>
        <a class="home-button home-button--commission" href="/help">Contanos tu idea →</a>
      </div>
    </section>
  </main>

  <HomeProductCard />

  <template id="home-empty-state-template">
    <div class="home-state" role="status">
      <h2>Todavía no hay piezas en el catálogo</h2>
    </div>
  </template>

  <template id="home-error-state-template">
    <div class="home-state" role="alert">
      <h2>No se pudo cargar</h2>
      <p>Verificá tu conexión e intentá de nuevo.</p>
    </div>
  </template>

  <template id="home-featured-product-template">
    <a class="home-featured-card__link" href="">
      <img class="home-featured-card__image" src="" alt="" width="420" height="420" loading="eager" decoding="async" />
      <div class="home-featured-card__caption">
        <div>
          <p class="home-featured-card__label">PIEZA DESTACADA</p>
          <h2 class="home-featured-card__name"></h2>
        </div>
        <p class="home-featured-card__price"></p>
      </div>
    </a>
  </template>

  <template id="home-featured-empty-state-template">
    <div class="home-featured-card__state" role="status">
      <p>No hay una pieza destacada disponible.</p>
      <a class="home-text-action" href="/products">Ver catálogo</a>
    </div>
  </template>

  <template id="home-featured-error-state-template">
    <div class="home-featured-card__state" role="alert">
      <p>No se pudo cargar la pieza destacada. Verificá tu conexión e intentá de nuevo.</p>
      <a class="home-text-action" href="/products">Ver catálogo</a>
    </div>
  </template>
</Layout>

<script>
  import { getCategoryImg, isPlaceholderImage } from '../domains/products';
  import { resolveImageUrl } from '../lib/imageUrl';
  import { fetchLatestProduct, fetchProducts } from '../domains/products/services/product.service';

  const formatPrice = (price: number): string => `$ ${new Intl.NumberFormat('es-AR').format(price)}`;

  async function loadFeaturedProduct(): Promise<void> {
    const content = document.getElementById('home-featured-content');
    const template = document.getElementById('home-featured-product-template') as HTMLTemplateElement | null;
    if (!content || !template) return;

    const showState = (id: string): void => {
      const stateTemplate = document.getElementById(id) as HTMLTemplateElement | null;
      if (stateTemplate) content.replaceChildren(stateTemplate.content.cloneNode(true));
    };

    let result: Awaited<ReturnType<typeof fetchLatestProduct>>;
    try {
      result = await fetchLatestProduct();
    } catch {
      showState('home-featured-error-state-template');
      return;
    }

    if (!result.ok) {
      showState(result.reason === 'not-found' ? 'home-featured-empty-state-template' : 'home-featured-error-state-template');
      return;
    }

    const clone = template.content.cloneNode(true) as DocumentFragment;
    const link = clone.querySelector('.home-featured-card__link') as HTMLAnchorElement | null;
    const image = clone.querySelector('.home-featured-card__image') as HTMLImageElement | null;
    const name = clone.querySelector('.home-featured-card__name') as HTMLElement | null;
    const price = clone.querySelector('.home-featured-card__price') as HTMLElement | null;
    const product = result.product;

    if (link) link.href = `/product?id=${product.id}`;
    if (image) {
      if (isPlaceholderImage(product.image)) {
        image.src = `/images/illustrations/${getCategoryImg(product.category)}.svg`;
        image.alt = `${product.category} — imagen no disponible`;
        image.classList.add('home-featured-card__image--placeholder');
      } else {
        image.src = resolveImageUrl(product.image, 'products');
        image.alt = product.name;
      }
      image.addEventListener('error', () => {
        if (image.dataset.fallback) return;
        image.dataset.fallback = 'true';
        image.src = `/images/illustrations/${getCategoryImg(product.category)}.svg`;
        image.alt = `${product.category} — imagen no disponible`;
        image.classList.add('home-featured-card__image--placeholder');
      });
    }
    if (name) name.textContent = product.name;
    if (price) price.textContent = formatPrice(product.price);
    content.replaceChildren(clone);
  }

  async function loadProducts(): Promise<void> {
    const container = document.getElementById('home-products-container');
    const loadingMsg = document.getElementById('home-loading-msg');
    const contentEl = document.getElementById('home-products-content');
    const gridContainer = document.getElementById('home-product-grid');
    if (!container) return;

    const showState = (id: string): void => {
      loadingMsg?.remove();
      contentEl?.remove();
      const template = document.getElementById(id) as HTMLTemplateElement | null;
      if (template) container.appendChild(template.content.cloneNode(true));
    };

    let result: Awaited<ReturnType<typeof fetchProducts>>;
    try {
      result = await fetchProducts();
    } catch {
      showState('home-error-state-template');
      return;
    }

    if (!result.ok) {
      showState('home-error-state-template');
      return;
    }

    if (result.products.length === 0) {
      showState('home-empty-state-template');
      return;
    }

    const cardTemp = document.getElementById('home-product-card-template') as HTMLTemplateElement | null;
    if (!cardTemp || !gridContainer || !contentEl) return;

    const products = result.products.slice(0, 6);

    const fragment = document.createDocumentFragment();
    for (const product of products) {
      const clone = cardTemp.content.cloneNode(true) as DocumentFragment;
      const catImg = getCategoryImg(product.category);
      const link = clone.querySelector('.home-product-card__link') as HTMLAnchorElement | null;
      const img = clone.querySelector('.home-product-card__image') as HTMLImageElement | null;
      const name = clone.querySelector('.home-product-card__name') as HTMLElement | null;
      const price = clone.querySelector('.home-product-card__price') as HTMLElement | null;

      if (link) link.href = `/product?id=${product.id}`;
      if (img) {
        if (isPlaceholderImage(product.image)) {
          img.src = `/images/illustrations/${catImg}.svg`;
          img.alt = `${product.category} — imagen no disponible`;
          img.classList.add('home-product-card__image--placeholder');
        } else {
          img.src = resolveImageUrl(product.image, 'products');
          img.alt = product.name;
        }
        img.addEventListener('error', () => {
          if (img.dataset.fallback) return;
          img.dataset.fallback = 'true';
          img.src = '/images/illustrations/Otras.svg';
          img.alt = 'Imagen de producto no disponible';
          img.classList.add('home-product-card__image--placeholder');
        });
      }
      if (name) name.textContent = product.name;
      if (price) price.textContent = formatPrice(product.price);
      fragment.appendChild(clone);
    }

    loadingMsg?.remove();
    gridContainer.appendChild(fragment);
    contentEl.hidden = false;
  }

  void loadFeaturedProduct();
  void loadProducts();
</script>
