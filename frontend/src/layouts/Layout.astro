---
import HomeHeader from '../components/HomeHeader.astro';
import HomeFooter from '../components/HomeFooter.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';

// Global styling imports
import '../styles/normalize.css';
import '../styles/tokens/colors.css';
import '../styles/tokens/typography.css';
import '../styles/tokens/spacing.css';
import '../styles/tokens/semantic.css';
import '../styles/base/reset.css';
import '../styles/base/layout.css';
import '../styles/base/utilities.css';
import '../styles/base/system-primitives.css';
import '../styles/components/nav-toggles.css';
import '../styles/components/carousel.css';
import '../styles/components/feature-strip.css';
import '../styles/components/home-shell.css';
import '../styles/components/home-brand.css';
import '../styles/components/home.css';
import '../styles/components/home-products.css';
import '../styles/components/home-footer.css';
import '../styles/components/home-responsive.css';
import '../styles/components/whatsapp-floating.css';
import '../styles/components/product-grid.css';
import '../styles/components/product-card.css';
import '../styles/components/price.css';
import '../styles/components/product-detail.css';
import '../styles/components/product-detail-states.css';
import '../styles/components/product-detail-responsive.css';
import '../styles/components/cart.css';
import '../styles/components/forms.css';
import '../styles/components/email-confirmation.css';
import '../styles/components/profile.css';
import '../styles/components/users-list.css';
import '../styles/components/alerts.css';
import '../styles/components/error-pages.css';
import '../styles/components/about.css';

interface Props {
	title?: string;
	variant?: 'default' | 'home';
}

const { title = "Mundo 3D", variant = 'default' } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/img/brand/Mundo3D_Isotipo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
		
		<!-- Theme initialization script (runs immediately to prevent flash of wrong theme) -->
		<script is:inline>
			(function () {
				const theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body class="home-shell">
		<HomeHeader pathname={Astro.url.pathname} />
		<slot />
			<HomeFooter />
			{variant === 'home' && <WhatsAppFloating />}
	</body>
</html>
