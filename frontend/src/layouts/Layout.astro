---
import HomeHeader from '../components/HomeHeader.astro';
import HomeFooter from '../components/HomeFooter.astro';

// Global styling imports
import '../styles/normalize.css';
import '../styles/tokens/colors.css';
import '../styles/tokens/typography.css';
import '../styles/fonts.css';
import '../styles/tokens/spacing.css';
import '../styles/tokens/semantic.css';
import '../styles/base/reset.css';
import '../styles/base/layout.css';
import '../styles/base/utilities.css';
import '../styles/base/system-primitives.css';
import '../styles/base/ui-kit.css';
import '../styles/components/nav-toggles.css';
import '../styles/components/home-shell.css';
import '../styles/components/home-brand.css';
import '../styles/components/home.css';
import '../styles/components/home-products.css';
import '../styles/components/home-footer.css';
import '../styles/components/home-responsive.css';
import '../styles/components/product-grid.css';
import '../styles/components/product-card.css';
import '../styles/components/price.css';
import '../styles/components/product-detail.css';
import '../styles/components/product-detail-states.css';
import '../styles/components/product-detail-responsive.css';
import '../styles/components/cart.css';
import '../styles/components/orders.css';
import '../styles/components/auth.css';
import '../styles/components/auth-file-picker.css';
import '../styles/components/email-confirmation.css';
import '../styles/components/alerts.css';
import '../styles/components/about.css';

interface Props {
	title?: string;
}

const { title = "Mundo 3D" } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/img/brand/Mundo3D_Isotipo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<title>{title}</title>

		<!-- Theme initialization script (runs immediately to prevent flash of wrong theme) -->
		<script is:inline>
			(function () {
				let stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch {
					stored = null;
				}
				const preference =
					stored === 'dark' || stored === 'system' || stored === 'light' ? stored : 'system';
				const resolved =
					preference === 'system'
						? window.matchMedia?.('(prefers-color-scheme: dark)')?.matches
							? 'dark'
							: 'light'
						: preference;
				const root = document.documentElement;
				root.setAttribute('data-theme', resolved);
				root.setAttribute('data-theme-preference', preference);
				const meta = document.querySelector('meta[name="color-scheme"]');
				if (meta) {
					meta.setAttribute('content', preference === 'system' ? 'light dark' : resolved);
				}
			})();
		</script>
	</head>
	<body class="home-shell">
		<a class="skip-link" href="#main-content">Saltar al contenido</a>
		<HomeHeader pathname={Astro.url.pathname} />
		<span id="main-content" class="skip-target" tabindex="-1"></span>
		<slot />
			<HomeFooter />
		<script>
			const main = document.querySelector('main');
			const skipLink = document.querySelector<HTMLAnchorElement>('.skip-link');
			if (main && skipLink) {
				if (!main.hasAttribute('tabindex')) main.setAttribute('tabindex', '-1');
				skipLink.addEventListener('click', (event) => {
					event.preventDefault();
					main.focus();
					main.scrollIntoView();
				});
			}
		</script>
	</body>
</html>
