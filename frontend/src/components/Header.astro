---
// Header component
---
<header class="navbar">
  <div class="container">
    <div class="navbar__inner">
      <!-- Logo -->
      <a href="/" class="navbar__logo" aria-label="Mundo 3D — Inicio">
        <img
          src="/img/brand/Mundo3D_Isologotipo.png"
          alt=""
          class="navbar__logo-image"
          width="1572"
          height="619"
        />
      </a>

      <!-- Search bar: disabled until real search ships (roadmap item), so the
      UI doesn't present a fake control that silently does nothing. -->
      <div class="navbar__search">
        <input
          type="text"
          placeholder="Búsqueda próximamente"
          aria-label="Búsqueda de productos (próximamente)"
          class="navbar__search-input"
          disabled
          title="La búsqueda todavía no está disponible"
        />
        <button
          type="button"
          aria-label="Búsqueda de productos (próximamente)"
          class="navbar__search-btn"
          disabled
          title="La búsqueda todavía no está disponible"
        >
          <svg
            class="navbar__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-4-4" />
          </svg>
        </button>
      </div>

      <!-- Navigation -->
      <nav class="navbar__list">
        <ul class="navbar__list--left">
          <li class="navbar__item"><a href="/#catalogo" class="navbar__link">Catálogo</a></li>
          <li class="navbar__item"><a href="/#encargos" class="navbar__link">Encargos</a></li>
          <li class="navbar__item"><a href="/products" class="navbar__link">Productos</a></li>
          <li class="navbar__item"><a href="/help" class="navbar__link">Ayuda</a></li>
          <li class="navbar__item admin-only" style="display: none;"><a href="/admin/products" class="navbar__link">Administrar productos</a></li>
        </ul>

        <ul class="navbar__list--right">
          <!-- Guest Navigation -->
          <li class="navbar__item guest-only"><a href="/login" class="navbar__link">Iniciar sesión</a></li>
          <li class="navbar__item guest-only"><a href="/register" class="navbar__link">Registrarse</a></li>

          <!-- User Navigation (Authenticated) -->
          <li class="nav-item user-only" style="display: none;">
            <div class="nav-item__trigger">
              <img id="navbar-avatar" src="/img/users/default-avatar.png" width="32" height="32" alt="Avatar" style="border-radius: 50%; object-fit: cover;" />
              <span class="navbar__greeting" id="navbar-greeting">Hola</span>
              <ul class="nav-item__dropdown">
                <li><a href="/profile">Mi perfil</a></li>
                <li><a href="/orders">Mis pedidos</a></li>
                <li><a href="#" id="navbar-logout">Cerrar sesión</a></li>
              </ul>
            </div>
          </li>

          <!-- Cart badge -->
          <li class="navbar__item">
            <a href="/cart" class="cart-link" aria-label="Carrito de compras">
              <svg
                class="navbar__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 3h2l2.4 11.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H6" />
                <circle cx="9" cy="20" r="1" />
                <circle cx="19" cy="20" r="1" />
              </svg>
              Carrito
              <span class="cart-link__badge" id="navbar-cart-badge" style="display: none;">0</span>
            </a>
          </li>

          <!-- Theme toggle -->
          <li class="navbar__item">
            <button class="theme-toggle-btn" id="theme-toggle" aria-label="Cambiar tema">
              <span class="theme-toggle-btn__icon">
                <svg
                  class="theme-toggle-btn__icon--sun"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
                <svg
                  class="theme-toggle-btn__icon--moon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 3a9 9 0 1 0 9 9c0-.7-.08-1.38-.23-2.03A7 7 0 0 1 14.03 3.23 9 9 0 0 0 12 3Z" />
                </svg>
              </span>
            </button>
          </li>


        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  import { initializeCartBadge } from '../scripts/cartBadge';
  import { initializeSessionUI } from '../scripts/sessionUI';
  import { initializeThemeToggle } from '../scripts/themeToggle';

  initializeSessionUI(document, window);
  initializeThemeToggle(document, localStorage);
  initializeCartBadge(document);
</script>
