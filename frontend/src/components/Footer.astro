---
import SocialIcon from './SocialIcon.astro';
---

<footer class="footer">
  <div class="container">
    <section class="footer__inner">

      <article class="footer__section">
        <h4>La Empresa</h4>
        <ul>
          <li><a href="/terms">Términos y condiciones</a></li>
          <li><a href="/privacy">Política de privacidad</a></li>
          <li><a href="/aboutUs">Nosotros</a></li>
        </ul>
      </article>

      <article class="footer__section">
        <h4>Ayuda</h4>
        <ul>
          <li><a href="/faq">Preguntas frecuentes</a></li>
          <li><a href="/step-by-step">Paso a paso</a></li>
          <li><a href="/help">Ayuda</a></li>
        </ul>
      </article>
    </section>

    <section class="footer__bottom">
      <article class="footer__copyright">
        <p>© 2023 Mundo3D. Todos los derechos reservados.</p>
      </article>
      <nav class="footer__social" aria-label="Redes sociales">
        <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <SocialIcon name="instagram" />
        </a>
        <a href="https://x.com/" target="_blank" rel="noopener noreferrer" aria-label="X">
          <SocialIcon name="x" />
        </a>
        <a href="https://www.tiktok.com/" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <SocialIcon name="tiktok" />
        </a>
      </nav>
    </section>
  </div>
</footer>
