<header class="home-header">
  <div class="home-header__inner">
    <div class="home-header__top">
      <a href="/" class="home-header__logo" aria-label="Mundo 3D — Inicio">
        <picture class="home-header__logo-full">
          <img src="/img/brand/Mundo3D_Isologotipo.png" alt="" width="140" height="55" />
        </picture>
        <picture class="home-header__logo-dark">
          <img src="/img/brand/Mundo3D_Isologotipo_Inverso.png" alt="" width="140" height="55" />
        </picture>
      </a>

      <div class="home-header__utility">
        <ul class="home-header__account">
          <li class="nav-item user-only" style="display: none;">
            <button
              class="nav-item__trigger"
              id="navbar-user-menu-trigger"
              type="button"
              aria-label="Menú de usuario"
              aria-expanded="false"
              aria-controls="navbar-user-menu"
              aria-haspopup="menu"
            >
              <img id="navbar-avatar" src="/img/users/default-avatar.png" width="32" height="32" alt="" />
              <span class="navbar__greeting" id="navbar-greeting">Hola</span>
            </button>
            <ul class="nav-item__dropdown" id="navbar-user-menu" role="menu" hidden>
              <li><a href="/profile" role="menuitem">Mi perfil</a></li>
              <li><a href="/orders" role="menuitem">Mis pedidos</a></li>
              <li><a href="#" id="navbar-logout" role="menuitem">Cerrar sesión</a></li>
            </ul>
          </li>
        </ul>

        <div class="home-header__actions">
          <a class="home-header__link home-header__cart" href="/cart" aria-label="Carrito de compras">
            <svg class="home-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3h2l2.4 11.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H6" />
              <circle cx="9" cy="20" r="1" />
              <circle cx="19" cy="20" r="1" />
            </svg>
            <span>Carrito</span>
            <span class="cart-link__badge" id="navbar-cart-badge" style="display: none;">0</span>
          </a>

          <button class="theme-toggle-btn home-header__theme" id="theme-toggle" type="button" aria-label="Cambiar tema">
            <span class="theme-toggle-btn__icon">
              <svg class="theme-toggle-btn__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
              <svg class="theme-toggle-btn__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.598.748-3.752A9.753 9.753 0 1 0 21.752 15.002Z" fill="currentColor" stroke="none" />
              </svg>
            </span>
          </button>

          <button
            class="home-header__menu-toggle"
            id="home-menu-toggle"
            type="button"
            aria-label="Abrir menú principal"
            aria-expanded="false"
            aria-controls="home-primary-navigation"
          >
            <svg class="home-header__menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <nav class="home-header__primary" id="home-primary-navigation" aria-label="Navegación principal" hidden>
      <div class="home-header__account-section">
        <h2 class="home-header__account-heading guest-only">Cuenta</h2>
        <ul class="home-header__auth-links">
          <li class="guest-only"><a class="home-header__link" href="/login">Iniciar sesión</a></li>
          <li class="guest-only"><a class="home-header__link" href="/register">Registrarse</a></li>
        </ul>
      </div>
      <ul>
        <li><a class="home-header__link home-header__link--active" href="/#catalogo">Productos</a></li>
        <li><a class="home-header__link" href="/#encargos">Encargos</a></li>
        <li><a class="home-header__link" href="/help">Ayuda</a></li>
        <li class="admin-only" style="display: none;"><a class="home-header__link" href="/admin/products">Administrar productos</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initializeCartBadge } from '../scripts/cartBadge';
  import { initializeHomeMenu } from '../scripts/homeMenu';
  import { initializeSessionUI } from '../scripts/sessionUI';
  import { initializeThemeToggle } from '../scripts/themeToggle';

  initializeHomeMenu(document);
  initializeSessionUI(document, window);
  initializeThemeToggle(document, localStorage);
  initializeCartBadge(document);
</script>
