---
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const currentPath = pathname === '/' ? pathname : pathname.replace(/\/+$/, '');
const productsIsCurrent = currentPath === '/products';
const helpIsCurrent = currentPath === '/help';
const stepByStepIsCurrent = currentPath === '/step-by-step';
const adminProductsIsCurrent = currentPath === '/admin/products';
const adminRequestsIsCurrent = currentPath === '/admin/commission-requests';
---

<header class="home-header">
  <div class="home-header__inner">
    <div class="home-header__top">
      <a href="/" class="home-header__logo" aria-label="Mundo 3D — Inicio">
        <picture class="home-header__logo-full">
          <img src="/img/brand/Mundo3D_Isologotipo.png" alt="" width="140" height="55" />
        </picture>
        <picture class="home-header__logo-dark">
          <img src="/img/brand/Mundo3D_Isologotipo_Inverso.png" alt="" width="140" height="55" />
        </picture>
      </a>

      <div class="home-header__utility">
        <ul class="home-header__account">
          <li class="nav-item user-only" style="display: none;">
            <button
              class="nav-item__trigger"
              id="navbar-user-menu-trigger"
              type="button"
              aria-label="Menú de usuario"
              aria-expanded="false"
              aria-controls="navbar-user-menu"
            >
              <img id="navbar-avatar" src="/img/users/default-avatar.png" width="32" height="32" alt="" />
              <span class="navbar__greeting" id="navbar-greeting">Hola</span>
            </button>
            <ul class="nav-item__dropdown" id="navbar-user-menu" hidden>
              <li><a href="/orders">Mis pedidos</a></li>
              <li><a href="#" id="navbar-logout">Cerrar sesión</a></li>
            </ul>
          </li>
        </ul>

        <div class="home-header__actions">
          <div class="home-header__cart-wrap">
            <button
              class="home-header__link home-header__cart"
              id="navbar-cart-trigger"
              type="button"
              aria-label="Carrito de compras"
              title="Carrito"
              aria-expanded="false"
              aria-controls="navbar-cart-menu"
            >
              <svg class="home-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 3h2l2.4 11.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H6" />
                <circle cx="9" cy="20" r="1" />
                <circle cx="19" cy="20" r="1" />
              </svg>
              <span class="cart-link__badge" id="navbar-cart-badge" style="display: none;">0</span>
            </button>

            <div class="mini-cart" id="navbar-cart-menu" role="region" aria-label="Resumen del carrito" hidden>
              <div class="mini-cart__header">
                <p class="mini-cart__title">Tu carrito</p>
                <span class="mini-cart__count" id="mini-cart-count"></span>
              </div>
              <div class="mini-cart__empty" id="mini-cart-empty">
                <p>Tu carrito está vacío.</p>
                <a class="mini-cart__secondary-link" href="/products">Ver el catálogo</a>
              </div>
              <div class="mini-cart__content" id="mini-cart-content" hidden>
                <ul class="mini-cart__list" id="mini-cart-list"></ul>
                <div class="mini-cart__footer">
                  <div class="mini-cart__total">
                    <span>Total</span>
                    <strong id="mini-cart-total">$ 0</strong>
                  </div>
                  <a class="mini-cart__cta" href="/cart">Ir al carrito</a>
                </div>
              </div>
            </div>
          </div>

          <button
            class="theme-toggle-btn home-header__theme"
            id="theme-toggle"
            type="button"
            aria-label="Tema: sistema. Cambiar a tema claro"
            title="Tema: sistema"
          >
            <span class="theme-toggle-btn__icon">
              <svg class="theme-toggle-btn__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
              <svg class="theme-toggle-btn__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
              </svg>
              <svg class="theme-toggle-btn__icon--system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <path d="M8 21h8M12 17v4" />
              </svg>
            </span>
          </button>

          <button
            class="home-header__menu-toggle"
            id="home-menu-toggle"
            type="button"
            aria-label="Abrir menú principal"
            aria-expanded="false"
            aria-controls="home-primary-navigation"
          >
            <svg class="home-header__menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="home-header__primary" id="home-primary-navigation" hidden>
      <nav class="home-header__nav" aria-label="Navegación principal">
        <ul>
          <li><a class:list={["home-header__link", { "home-header__link--active": productsIsCurrent }]} href="/products" aria-current={productsIsCurrent ? 'page' : undefined}>Catálogo</a></li>
          <li><a class:list={["home-header__link", { "home-header__link--active": helpIsCurrent }]} href="/help" aria-current={helpIsCurrent ? 'page' : undefined}>Encargos</a></li>
          <li><a class:list={["home-header__link", { "home-header__link--active": stepByStepIsCurrent }]} href="/step-by-step" aria-current={stepByStepIsCurrent ? 'page' : undefined}>Cómo funciona</a></li>
          <li class="admin-only" style="display: none;"><a class:list={["home-header__link", { "home-header__link--active": adminProductsIsCurrent }]} href="/admin/products" aria-current={adminProductsIsCurrent ? 'page' : undefined}>Administrar productos</a></li>
          <li class="admin-only" style="display: none;">
            <a
              class:list={["home-header__link", { "home-header__link--active": adminRequestsIsCurrent }]}
              href="/admin/commission-requests"
              aria-current={adminRequestsIsCurrent ? 'page' : undefined}
            >
              Solicitudes de encargo
            </a>
          </li>
        </ul>
      </nav>
      <div class="home-header__account-section">
        <p class="home-header__account-heading guest-only">Cuenta</p>
        <ul class="home-header__auth-links">
          <li class="guest-only"><a class="home-header__link" href="/login">Iniciar sesión</a></li>
          <li class="guest-only"><a class="home-header__link home-header__register" href="/register">Registrarse</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  import { initializeCartBadge } from '../scripts/cartBadge';
  import { initializeHomeMenu } from '../scripts/homeMenu';
  import { initializeMiniCart } from '../scripts/miniCart';
  import { initializeSessionUI } from '../scripts/sessionUI';
  import { initializeThemeToggle } from '../scripts/themeToggle';

  initializeHomeMenu(document);
  initializeSessionUI(document, window);
  initializeThemeToggle(document, localStorage);
  initializeCartBadge(document);
  initializeMiniCart(document);
</script>
