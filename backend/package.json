{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mundo-3D backend — Express API server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "tsc -p tsconfig.build.json",
    "architecture:check": "node tools/architecture/check.js",
    "test": "jest",
    "test:fast": "jest",
    "test:integration": "jest --config jest.integration.config.js --detectOpenHandles",
    "test:coverage": "jest --coverage && node scripts/generate-coverage-risk-map.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.js\"",
    "type-check": "tsc --noEmit",
    "db:test:prepare": "node src/database/test-prepare.js",
    "db:migrate": "node src/database/migrate.js up",
    "db:migrate:status": "node src/database/migrate.js pending",
    "db:migrate:down": "node src/database/migrate.js down",
    "db:migrate:adopt-baseline": "node src/database/migrate.js adopt-baseline",
    "deploy:migrate-and-start": "node ../scripts/deploy/migrate-and-start.js",
    "deploy:smoke-test": "node ../scripts/deploy/smoke-test.js",
    "deploy:env-preflight": "node ../scripts/deploy/env-preflight.js",
    "deploy:start": "node ../scripts/deploy/env-preflight.js && node ../scripts/deploy/migrate-and-start.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "8.6.2",
    "express-validator": "^7.0.1",
    "helmet": "8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.9.7",
    "pino": "10.3.1",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "6.3.0",
    "umzug": "^3.8.3",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "25.9.2",
    "@types/sequelize": "4.28.20",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "eslint": "10.4.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "17.6.0",
    "jest": "30.4.2",
    "nodemon": "^3.1.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.24.0"
  }
}
