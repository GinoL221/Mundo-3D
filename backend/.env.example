# Server port
PORT=3031

# Database credentials
DB_USER=root
DB_PASS=
DB_NAME=mundo_3d_db
DB_HOST=localhost

# Session and Cookie encryption keys (generate strong random strings)
COOKIE_SECRET=change-me-to-a-random-secret

# JWT secret key for token authentication
JWT_SECRET=change-me-to-a-random-secret


# Graceful shutdown drain deadline in milliseconds (see runtime-resilience design)
SHUTDOWN_TIMEOUT_MS=10000
