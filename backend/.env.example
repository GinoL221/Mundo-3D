# Server
PORT=3031
SHUTDOWN_TIMEOUT_MS=10000

# Database
DB_USER=root
DB_PASS=
DB_NAME=mundo_3d_db
DB_HOST=localhost
DB_PORT=3306
DB_CA_CERT=

# Session and security
COOKIE_SECRET=change-me-to-a-random-secret
JWT_SECRET=change-me-to-a-random-secret
COOKIE_DOMAIN=

# CORS
# Leave empty in local development.
CORS_ORIGIN=

# Logging
LOG_LEVEL=info

# Login/register rate limits
LOGIN_LIMIT_WINDOW=
LOGIN_LIMIT_MAX=
ACCOUNT_LOGIN_LIMIT_WINDOW=
ACCOUNT_LOGIN_LIMIT_MAX=
REGISTER_LIMIT_WINDOW=
REGISTER_LIMIT_MAX=

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# Access token lifetime in seconds
ACCESS_TOKEN_TTL_SECONDS=1800

# Refresh token rate limits
REFRESH_LIMIT_WINDOW=900000
REFRESH_LIMIT_MAX=10

# Refresh token retention in seconds
REFRESH_TOKEN_REAP_SECONDS=86400

# Public frontend origin used in email-confirmation links
PUBLIC_APP_URL=http://localhost:4321

# SMTP / Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.test
