# Server port
PORT=3031

# Database credentials
DB_USER=root
DB_PASS=
DB_NAME=mundo_3d_db
DB_HOST=localhost
DB_PORT=3306
DB_CA_CERT=

# Session and Cookie encryption keys (generate strong random strings)
COOKIE_SECRET=change-me-to-a-random-secret

# JWT secret key for token authentication
JWT_SECRET=change-me-to-a-random-secret


# Graceful shutdown drain deadline in milliseconds (see runtime-resilience design)
SHUTDOWN_TIMEOUT_MS=10000

# Root domain shared by frontend and backend cookies (e.g. mundo3d.com).
# REQUIRED in production: without it, the httpOnly/CSRF/display cookies are
# scoped only to the exact API subdomain (api.mundo3d.com) and the frontend
# subdomain (mundo3d.com) can't read m3d_user/m3d_csrf. Leave unset in
# local dev — cookieOptions.ts omits the `domain` flag entirely when this is
# empty, which is what you want on localhost.
COOKIE_DOMAIN=tudominio.com

# Required in production — see backend/src/app.js CORS guard. Comma-free,
# single origin (e.g. https://mundo3d.com). Unset in local dev falls back
# to localhost:4321/localhost:3000.
CORS_ORIGIN=

# Log verbosity (pino). Defaults to 'info', or 'silent' under test.
LOG_LEVEL=info

# Login/register rate limiter overrides (ms window, max attempts).
# Optional — each middleware has its own built-in default if unset.
# LOGIN_LIMIT_* is the per-IP gate (default 10 failures / 15 min): it counts
# only failed attempts, and it is what caps password spraying, which never
# trips a per-account counter. ACCOUNT_LOGIN_LIMIT_* is the per-account gate
# (default 5 failures / 15 min), keyed on the submitted email so a
# distributed attacker cannot buy a fresh budget by changing source IP.
# Both apply to POST /api/users/login; the stricter one wins.
LOGIN_LIMIT_WINDOW=
LOGIN_LIMIT_MAX=
ACCOUNT_LOGIN_LIMIT_WINDOW=
ACCOUNT_LOGIN_LIMIT_MAX=
REGISTER_LIMIT_WINDOW=
REGISTER_LIMIT_MAX=

# Cloudflare R2 (object storage for admin-uploaded product/user images).
# See scripts/deploy/env-preflight.js and render.yaml for what's required
# in production.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# Access-token lifetime in SECONDS. Fixed regardless of "Recuérdame" — that
# distinction now lives on the refresh token instead. Default 1800 (30 min).
# This is also the no-deploy rollback lever: raising it restores long-lived
# sessions while the refresh endpoint stays available. It is the window in
# which a token captured before logout still works, so lower is safer.
ACCESS_TOKEN_TTL_SECONDS=1800

# Rate limiter for POST /api/users/refresh (ms window, max attempts).
# Optional — the middleware has these same built-in defaults if unset.
REFRESH_LIMIT_WINDOW=900000
REFRESH_LIMIT_MAX=10

# Segundos que sobrevive la fila de un refresh token ya rotado, como evidencia
# para detectar reuso. Independiente de la ventana de gracia de 30s. Default: 86400 (24h).
REFRESH_TOKEN_REAP_SECONDS=86400
