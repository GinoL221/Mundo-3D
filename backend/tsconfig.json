{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node", "supertest"],
    // Required while module is "commonjs" and ts-jest falls back to moduleResolution=node10 (TS5107).
    // Remove once the backend migrates to ESM/nodenext or moduleResolution="bundler" with TS 6+ across editor and CI.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"],
  "ts-node": {
    "files": true,
    "transpileOnly": true
  }
}
